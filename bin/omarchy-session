    "omp": dict(bins=["omp"], ids=["--resume"], resume=["--resume={id}"], cont=None),
    "agy": dict(bins=["agy"], ids=["--conversation"], resume=["--conversation", "{id}"], cont=None),
    "letta": dict(bins=["letta"], pkg=["@letta-ai/letta-code"], ids=["--conversation"],
                  resume=["--conversation", "{id}"], cont=["--continue"]),
    "mastracode": dict(bins=["mastracode"], ids=["--thread"], resume=["--thread", "{id}"], cont=None),
    "crush": dict(bins=["crush"], pkg=["/installs/crush/"], resume=None, cont=None,
                  carry_bare=["--yolo", "-y"], skip=["run", "logs"]),
    "aider": dict(bins=["aider"], pkg=["aider-chat", "/aider/"], resume=None, cont=["--restore-chat-history"],
                  carry=["--model"], carry_bare=["--yes-always"], skip=["--message", "-m", "--message-file"]),
    "goose": dict(bins=["goose"], pkg=["/goose/"], resume=["session", "--resume", "--session-id", "{id}"],
                  cont=["session", "--resume"], skip=["run"]),
    "amp": dict(bins=["amp"], pkg=["@sourcegraph/amp"], resume=["threads", "continue", "{id}"],
                cont=["threads", "continue"], carry_bare=["--dangerously-allow-all"], skip=["-x", "--execute"]),
}
INTERPRETERS = re.compile(r"(node|nodejs|bun|deno|python3?(\.\d+)?)$")


def flag_value(args, flags):
    """Value of the first of `flags` (--f=v or --f v): None if absent, '' if bare."""
    for i, a in enumerate(args):
        if a == "--":
            break
        for f in flags:
            if a == f:
                nxt = args[i + 1] if i + 1 < len(args) else ""
                return "" if (not nxt or nxt.startswith("-")) else nxt
            if a.startswith(f + "=") and f.startswith("--"):
                return a[len(f) + 1:]
    return None


def carried_flags(args, spec):
    out, i = [], 0
    bare, valued = spec.get("carry_bare", []), spec.get("carry", [])
    while i < len(args):
        a = args[i]
        if a == "--":
            break
        if a in bare:
            out.append(a)
        elif a in valued and i + 1 < len(args):
            out += [a, args[i + 1]]
            i += 1
        elif "=" in a and a.split("=", 1)[0] in valued and a.startswith("--"):
            out.append(a)
        i += 1
    return out


def match_agent(pid):
    """(name, spec, args-after-program, bin) if pid is a known coding agent."""
    argv = cmdline(pid)
    if not argv or is_shell(pid):
        return None
    exe = exe_of(pid)
    b0 = base(argv[0])
    interp = bool(INTERPRETERS.match(b0)) or bool(INTERPRETERS.match(base(exe)))
    entry_i = None
    if interp:
        for i, a in enumerate(argv[1:], 1):
            if a in ("-m", "-c"):
                entry_i = i + 1 if a == "-m" else None
                break
            if not a.startswith("-"):
                entry_i = i
                break
    for name, spec in AGENTS.items():
        bins, pkg = spec["bins"], spec.get("pkg", [])
        if b0 in bins:
            return name, spec, argv[1:], b0
        if not interp and (base(exe) in bins or any(m in exe or m in argv[0] for m in pkg)):
            return name, spec, argv[1:], bins[0]
        if interp and entry_i is not None and entry_i < len(argv):
            e = argv[entry_i]
            if base(e) in bins or any(m in e for m in pkg) or e.replace("_", "-") in bins:
                return name, spec, argv[entry_i + 1:], bins[0]
    return None


def fd_match(pid, rx):
    rx = re.compile(rx)
    found = None
    for pid_ in [pid] + children(pid):
        for fd in glob.glob(f"/proc/{pid_}/fd/*"):
            try:
                m = rx.search(os.readlink(fd))
            except OSError:
                continue
            if m:
                found = m.group(1)
    return found


NO_CONVERSATION = "no conversation yet"


def agent_session_id(name, spec, pid, args, cwd):
    """(id, where it came from) or (None, ''). Live state (session registries,
    open transcript files) wins over the command line, because the user may
    have switched conversations (/new, /resume) since the agent started."""
    try:
        if name == "grok":
            with open(os.path.join(HOME, ".grok", "active_sessions.json")) as f:
                data = json.load(f)
            mine = [e for e in (data if isinstance(data, list) else data.get("sessions", []))
                    if isinstance(e, dict) and e.get("pid") == pid and e.get("session_id")]
            mine.sort(key=lambda e: str(e.get("opened_at", "")))
            if mine and ID_RE.fullmatch(str(mine[-1]["session_id"])):
                return str(mine[-1]["session_id"]), "~/.grok/active_sessions.json"
            if not mine and not fd_match(pid, spec["fd"]):
                # grok registers a session when the first message is sent
                return None, NO_CONVERSATION
        if name == "claude":
            p = os.path.join(HOME, ".claude", "sessions", f"{pid}.json")
            if os.path.exists(p):
                with open(p) as f:
                    sid = str(json.load(f).get("sessionId", ""))
                if ID_RE.fullmatch(sid):
                    return sid, "~/.claude/sessions"
    except (OSError, ValueError, AttributeError):
        pass
    if spec.get("fd"):
        v = fd_match(pid, spec["fd"])
        if v and ID_RE.fullmatch(v):
            return v, "open session file"
    v = None
    if spec.get("sub") and args[:1] == [spec["sub"]]:
        v = args[1] if len(args) > 1 and not args[1].startswith("-") else None
    elif spec.get("ids"):
        v = flag_value(args, spec["ids"])
    if v and ID_RE.fullmatch(v):
        return v, "command line"
    if name == "claude" and cwd:
        d = os.path.join(HOME, ".claude", "projects", re.sub(r"[^A-Za-z0-9]", "-", cwd))
        started = proc_start_epoch(pid)
        files = [(os.path.getmtime(f), f) for f in glob.glob(os.path.join(d, "*.jsonl"))]
        files = [x for x in files if x[0] >= started - 5]
        if files:
            sid = base(max(files)[1])[:-len(".jsonl")]
            if ID_RE.fullmatch(sid):
                return sid, "newest transcript for this directory"
    return None, ""


def agent_resume(shell_pid):
    """How to restart the coding agent running in this shell, or None."""
    kids = children(shell_pid)
    if not kids:
        return None
    queue = [(kids[-1], 0)]
    while queue:
        pid, depth = queue.pop(0)
        m = match_agent(pid)
        if m:
            name, spec, args, prog = m
            if any(a in spec.get("skip", []) for a in args[:1]) or \
               any(a in spec.get("skip", []) for a in args if a.startswith("-")):
                return None
            cwd = cwd_of(pid)
            sid, src = agent_session_id(name, spec, pid, args, cwd)
            if sid and spec.get("resume"):
                tail = [x.replace("{id}", sid) for x in spec["resume"]]
                label = f"{name} — resume session {sid} (id from {src})"
            elif src == NO_CONVERSATION:
                tail = []
                label = f"{name} — start fresh (it had no conversation yet; no prompt is sent)"
            elif spec.get("cont"):
                tail = list(spec["cont"])
                label = f"{name} — continue latest session in this directory (no id found)"
            else:
                tail = []
                label = f"{name} — restart (no resume support known; no prompt is sent)"
            carry = carried_flags(args, spec)
            argv = [prog] + (tail + carry if tail and not tail[0].startswith("-") else carry + tail)
            return {"resume": argv, "label": label, "cwd": cwd, "agent": name}
        if depth < 2:
            queue += [(k, depth + 1) for k in reversed(children(pid))]
    return None


def proc_start_epoch(pid):
    try:
        with open("/proc/stat") as f:
            bt = next(int(ln.split()[1]) for ln in f if ln.startswith("btime "))
    except (OSError, StopIteration, ValueError):
        return 0
    return bt + stat_of(pid)["start"] / os.sysconf("SC_CLK_TCK")


def shell_hook_state(pid):
    """(hooked, atuin_session) as recorded by shell/session-hook.sh for this shell."""
    p = os.path.join(RUNTIME_DIR, f"shell-{pid}")
    try:
        st = os.stat(p)
        if st.st_uid != os.getuid() or st.st_mtime + 2 < proc_start_epoch(pid):
            return False, ""   # stale file from an earlier process with the same pid
        with open(p) as f:
            v = f.read(100).strip()
    except OSError:
        return False, ""
    return True, (v if ATUIN_RE.fullmatch(v) else "")


def cleanup_shell_files():
    for p in glob.glob(os.path.join(RUNTIME_DIR, "shell-*")):
        n = base(p)[6:]
        if n.isdigit() and not os.path.exists(f"/proc/{n}"):
            try:
                os.unlink(p)
            except OSError:
                pass


def shell_info(cfg, k):
    cwd = cwd_of(k) or HOME
    hooked, atuin = shell_hook_state(k)
    resume, label = resume_argv(cfg, k), ""
    if resume:
        label = base(resume[0])
    elif cfg.get("resume_agents", True):
        ag = agent_resume(k)
        if ag:
            resume, label = ag["resume"], ag["label"]
            cwd = ag["cwd"] or cwd
    return {"pid": k, "start": stat_of(k)["start"], "cwd": cwd, "resume": resume,
            "label": label, "atuin": atuin, "hooked": hooked}


def title_paths(title):
    """Candidate directories mentioned in a terminal title like 'host: ~/src'."""
    cands = []
    for part in re.split(r"[:\s—–|]+\s*", title) + [title]:
        part = part.strip()
        if part.startswith("~"):
            cands.append(os.path.expanduser(part))
        elif part.startswith("/"):
            cands.append(part)
    return [os.path.normpath(c) for c in cands]


def terminal_base_argv(term_key, spec, pargv, desk_entry):
    if spec and spec.get("launcher"):
        b = shutil.which(spec["launcher"]) or spec["launcher"]
        return [b]
    if desk_entry:
        return list(desk_entry["argv"])
    if not pargv:
        return []
    keep = set((spec or {}).get("keep", []))
    out = [pargv[0]]
    dirflag = (spec or {}).get("dir", ("",))[-1] if spec and spec["dir"][0] in ("eq", "sep") else None
    skip_next = False
    for a in pargv[1:]:
        if skip_next:
            skip_next = False
            continue
        if spec and a == spec.get("exec"):
            break
        if dirflag and (a == dirflag):
            skip_next = True
            continue
        if dirflag and a.startswith(dirflag + "="):
            continue
        if a.startswith("--") and "=" in a or a in keep:
            out.append(a)
    return out


def ensure_terminal_class(argv, cls, spec=None):
    """Keep a custom app id such as org.omarchy.terminal on the relaunch.

    Omarchy's floating terminal is ghostty with a different class. Without
    --class= the new window shows up as com.mitchellh.ghostty and the restore
    waits for a class that never appears.
    """
    argv = list(argv or [])
    if not argv or not cls or not spec:
        return argv
    defaults = {x.lower() for x in spec.get("classes") or []}
    if cls.lower() in defaults:
        return argv
    flag = spec.get("class_flag") or ""
    if not flag:
        return argv
    if any(a == flag or a.startswith(flag + "=") for a in argv):
        return argv
    argv.insert(1, f"{flag}={cls}")
    return argv


def terminal_launch(term_key, spec, base_argv, cwd, resume, default_ids, desk_entry):
    # Run a resumed program inside the user's shell so the window stays open
    # afterwards. The script is constant; the program is passed as "$@".
    cmd = None
    if resume:
        sh = os.environ.get("SHELL") or "/bin/bash"
        cmd = [sh, "-c", '"$@"; exec "${SHELL:-/bin/bash}"', "omarchy-session"] + list(resume)
    if spec is None:
        if desk_entry and default_ids and desk_entry["id"] in default_ids[:1] and shutil.which("xdg-terminal-exec"):
            return ["xdg-terminal-exec", f"--dir={cwd}"] + (cmd or [])
        return ["env", "-C", cwd] + base_argv + (["-e"] + cmd if cmd else [])
    drop = spec.get("drop", [])
    base_argv = [a for i, a in enumerate(base_argv)
                 if i == 0 or not any(a == d or a.startswith(d + "=") for d in drop)] + spec.get("add", [])
    style = spec["dir"]
    if style[0] == "wezterm":
        return [base_argv[0] if base_argv else "wezterm", "start", "--cwd", cwd] + (["--"] + cmd if cmd else [])
    if style[0] == "eq":
        argv = list(base_argv) + [f"{style[1]}={cwd}"]
    elif style[0] == "sep":
        argv = list(base_argv) + [style[1], cwd]
    else:
        argv = ["env", "-C", cwd] + list(base_argv)
    if cmd:
        argv += ([spec["exec"]] if spec.get("exec") else []) + cmd
    return argv


def norm_title(t):
    t = re.sub(r"^\(\d[\d,]*\)\s*", "", t or "")
    t = re.sub(r"\s+[-—–]\s+(Google Chrome|Chromium|Brave|Microsoft\s*Edge|Vivaldi|"
               r"Mozilla Firefox|Firefox|LibreWolf|Zen Browser|Helium)$", "", t)
    return t.strip().lower()


# Browser window titles move while Chrome is restoring: unread counts change,
# and a window often shows only the site name ("Gmail", "JLCPCB") before the
# full tab title arrives. Matching uses this key instead of the raw title.
_BROWSER_SUFFIX_RE = re.compile(
    r"\s+[-—–]\s+(?:google chrome|chromium|brave|microsoft\s*edge|vivaldi|"
    r"mozilla firefox|firefox|librewolf|zen browser|helium)$",
    re.I)
_UNREAD_RE = re.compile(r"\s*\(\d[\d,]*\)")
_EMAIL_RE = re.compile(r"[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}")
_GENERIC_TITLE = {
    "gmail", "youtube", "google", "google chrome", "chrome", "chromium",
    "new tab", "inbox", "google search", "untitled",
}
_TITLE_ACCEPT = 0.72
_TITLE_ACCEPT_UNKNOWN_PROFILE = 0.88
# Different mailboxes share the "Inbox (…) - …" shape. Cap that score under
# every accept threshold so one profile cannot take the other's window.
_TITLE_EMAIL_CONFLICT = 0.35
_SNSS_MAGIC = b"SNSS"
_SESSION_NAME_RE = re.compile(r"^(Session|Tabs|App)_(\d+)$")
_CHROME_SESSION_MAX_BYTES = 80_000_000
_COLUMN_X_SLACK = 80


def browser_title_key(title):
    """Stable comparison key: drop the browser suffix and unread counts."""
    t = _BROWSER_SUFFIX_RE.sub("", title or "")
    t = _UNREAD_RE.sub("", t)
    t = t.replace("—", "-").replace("–", "-")
    t = re.sub(r"\s+", " ", t).strip(" -").lower()
    return t


def _title_has_token(hay, token):
    if not token:
        return False
    return re.search(r"(^|[^a-z0-9])" + re.escape(token) + r"([^a-z0-9]|$)", hay) is not None


def title_similarity(saved, live):
    """1.0 is the same window. Email conflicts stay below every accept threshold."""
    a, b = browser_title_key(saved), browser_title_key(live)
    if not a or not b:
        return 0.0
    if a == b:
        return 1.0
    emails_a, emails_b = set(_EMAIL_RE.findall(a)), set(_EMAIL_RE.findall(b))
    ratio = difflib.SequenceMatcher(None, a, b).ratio()
    shorter, longer = (a, b) if len(a) <= len(b) else (b, a)
    contain = 0.0
    if shorter not in _GENERIC_TITLE and len(shorter) >= 6 and _title_has_token(longer, shorter):
        contain = 0.9
    score = max(ratio, contain)
    if emails_a and emails_b and emails_a.isdisjoint(emails_b):
        score = min(score, _TITLE_EMAIL_CONFLICT)
    return score


def only_candidate_match(saved, live):
    """Last saved window vs last live window, after the strict pass.

    A loading window titled "Gmail" or "JLCPCB" will not clear the strict
    threshold against the full saved title, but it is safe to take when it is
    the only window left for this profile.
    """
    if title_similarity(saved, live) >= _TITLE_ACCEPT:
        return True
    sk, lk = browser_title_key(saved), browser_title_key(live)
    if not sk or not lk:
        return False
    emails_s, emails_l = set(_EMAIL_RE.findall(sk)), set(_EMAIL_RE.findall(lk))
    if emails_s and emails_l and emails_s.isdisjoint(emails_l):
        return False
    if _title_has_token(sk, lk) and len(lk) >= 4:
        return True
    return title_similarity(saved, live) >= 0.5


def match_saved_windows(saved, clients, profile="", desperate=False):
    """One-to-one match of saved windows to live clients.

    `profile` excludes clients that belong to another Chromium profile.
    Clients with an unknown profile need a stronger score so two inboxes
    cannot cross. Returns (pairs, notes) where pairs are
    (saved_index, client_index, score) and notes describe still-unmatched
    saved windows.
    """
    threshold = 0.4 if desperate else _TITLE_ACCEPT
    eligible = []
    for i, c in enumerate(clients):
        cp = c.get("profile") or ""
        if profile and cp and cp != profile:
            continue
        eligible.append(i)
    used_c, used_w = set(), set()
    scored = []
    for ci in eligible:
        cp = clients[ci].get("profile") or ""
        need = threshold if (not profile or cp == profile) else _TITLE_ACCEPT_UNKNOWN_PROFILE
        if profile and not cp and not desperate:
            need = max(need, _TITLE_ACCEPT_UNKNOWN_PROFILE)
        for wi, w in enumerate(saved):
            scored.append((title_similarity(w.get("title"), clients[ci].get("title")), ci, wi, need))
    pairs = []
    for score, ci, wi, need in sorted(scored, key=lambda row: row[0], reverse=True):
        if ci in used_c or wi in used_w or score < need:
            continue
        used_c.add(ci)
        used_w.add(wi)
        pairs.append((wi, ci, score))
    left_w = [wi for wi in range(len(saved)) if wi not in used_w]
    left_c = [ci for ci in eligible if ci not in used_c]
    # One window left: a loading title ("Gmail", "JLCPCB") or the only app window.
    if len(left_w) == 1 and len(left_c) == 1 and (
            desperate or only_candidate_match(saved[left_w[0]].get("title"), clients[left_c[0]].get("title"))):
        wi, ci = left_w[0], left_c[0]
        used_w.add(wi)
        used_c.add(ci)
        pairs.append((wi, ci, title_similarity(saved[wi].get("title"), clients[ci].get("title"))))
    notes = []
    for wi, w in enumerate(saved):
        if wi in used_w:
            continue
        best_s, best_t, best_p = 0.0, "", ""
        for c in clients:
            s = title_similarity(w.get("title"), c.get("title"))
            if s >= best_s:
                best_s, best_t, best_p = s, c.get("title") or "", c.get("profile") or ""
        notes.append({
            "title": w.get("title") or "",
            "workspace": w.get("workspace"),
            "best": best_s,
            "best_title": best_t,
            "best_profile": best_p,
            "candidates": len(clients),
            "profile_candidates": len(eligible),
        })
    return pairs, notes


def leftover_claim_ids(group_profile, group_class, other_group_waiting, clients):
    """Addresses a finished match group may claim.

    Another pending group of the same class must be able to see windows that
    are not known to belong to this profile. Claiming them early is what left
    every Chrome window on the launch workspace.
    """
    claim = []
    for c in clients:
        if (c.get("class") or "") != group_class:
            continue
        cp = c.get("profile") or ""
        if group_profile and cp and cp != group_profile:
            continue
        if not cp and other_group_waiting:
            continue
        addr = c.get("address")
        if addr:
            claim.append(addr)
    return claim


def clip_title(title, n=80):
    title = title or ""
    return title if len(title) <= n else title[:n]


def column_groups(ids_and_x, slack=_COLUMN_X_SLACK):
    """Group (id, x) pairs that share a scrolling column (nearly the same x)."""
    groups = []
    for item in sorted(ids_and_x, key=lambda t: t[1]):
        if groups and abs(item[1] - groups[-1][0][1]) <= slack:
            groups[-1].append(item)
        else:
            groups.append([item])
    return groups


def inversion_index(actual_ids, desired_ids):
    """First adjacent pair that is out of desired order, or None."""
    rank = {a: i for i, a in enumerate(desired_ids)}
    for i in range(len(actual_ids) - 1):
        if rank.get(actual_ids[i], 0) > rank.get(actual_ids[i + 1], 0):
            return i
    return None


def snss_header_ok(path):
    try:
        with open(path, "rb") as f:
            return f.read(4) == _SNSS_MAGIC
    except OSError:
        return False


def newest_snss(directory, prefix):
    """Newest Session_/Tabs_ file that still has Chromium's SNSS header."""
    if not directory or not os.path.isdir(directory):
        return None
    found = []
    for name in os.listdir(directory):
        m = re.match(rf"^{re.escape(prefix)}_(\d+)$", name)
        if not m:
            continue
        path = os.path.join(directory, name)
        try:
            size = os.path.getsize(path)
        except OSError:
            continue
        if 8 <= size <= _CHROME_SESSION_MAX_BYTES and snss_header_ok(path):
            found.append((int(m.group(1)), path))
    if not found:
        return None
    found.sort()
    return found[-1][1]


def next_session_stamp(names):
    stamps = []
    for name in names:
        m = _SESSION_NAME_RE.match(name)
        if m:
            stamps.append(int(m.group(2)))
    return (max(stamps) if stamps else 0) + 1


def chrome_sidecar_dir(user_data, profile):
    key = hashlib.sha256(f"{os.path.realpath(user_data)}\0{profile}".encode()).hexdigest()[:16]
    return os.path.join(STATE_DIR, "chrome-sessions", key)


def chromium_exit_kind(user_data, profile):
    """How Chrome last quit: 'normal', 'ended', 'crashed', or None.

    A normal quit and a SessionEnded reboot both leave a session file that
    has already recorded window closes, so only the last window comes back.
    A crash leaves the full session on disk; that file must not be replaced.
    """
    path = os.path.join(user_data, profile, "Preferences")
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            prefs = json.load(f)
    except (OSError, ValueError):
        return None
    prof = prefs.get("profile") if isinstance(prefs, dict) else None
    if not isinstance(prof, dict):
        return None
    kind = str(prof.get("exit_type") or "")
    clean = prof.get("exited_cleanly")
    if kind == "Crashed":
        return "crashed"
    if kind == "Normal" and clean is True:
        return "normal"
    # SessionEnded is what a reboot often records: the session file already
    # contains the window closes, same as a normal quit.
    if kind:
        return "ended"
    if clean is False:
        return "crashed"
    return None


def _copy_private(src, dest):
    parent = os.path.dirname(dest)
    os.makedirs(parent, mode=0o700, exist_ok=True)
    try:
        os.chmod(parent, 0o700)
    except OSError:
        pass
    fd, tmp = tempfile.mkstemp(dir=parent, prefix=".session.")
    try:
        with os.fdopen(fd, "wb") as out, open(src, "rb") as inp:
            size = os.fstat(inp.fileno()).st_size
            if size < 8 or size > _CHROME_SESSION_MAX_BYTES:
                raise OSError("session file size out of range")
            data = inp.read(size)
        if not data.startswith(_SNSS_MAGIC):
            raise OSError("not an SNSS session file")
        with open(tmp, "wb") as out:
            out.write(data)
        os.chmod(tmp, 0o600)
        os.replace(tmp, dest)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return len(data) if isinstance(data, (bytes, bytearray)) else 0


def copy_chromium_sessions(sess):
    """Copy each Chromium profile's current session next to our snapshot.

    Called when the window list changes and on the final pre-logout save.
    The copy is what restore puts back after a clean exit.
    """
    seen = set()
    for it in sess.get("items") or []:
        if it.get("kind") != "browser":
            continue
        prof = it.get("profile") or ""
        argv = it.get("argv") or []
        if not prof or not argv:
            continue
        ud = chromium_user_data(base(argv[0]), "", argv)
        if not ud:
            continue
        key = (os.path.realpath(ud), prof)
        if key in seen:
            continue
        seen.add(key)
        src_dir = os.path.join(ud, prof, "Sessions")
        session_src, tabs_src = newest_snss(src_dir, "Session"), newest_snss(src_dir, "Tabs")
        if not session_src or not tabs_src:
            log(f"save: no chrome session files to snapshot for profile {prof}")
            continue
        dest = chrome_sidecar_dir(ud, prof)
        try:
            n1 = _copy_private(session_src, os.path.join(dest, "Session"))
            n2 = _copy_private(tabs_src, os.path.join(dest, "Tabs"))
        except OSError as e:
            log(f"save: chrome session snapshot failed for profile {prof}: {e}")
            continue
        log(f"save: chrome session snapshot profile={prof} session_bytes={n1} tabs_bytes={n2}")


def install_chromium_session(user_data, profile, running=False, enabled=True):
    """Install the pre-logout session as Chromium's newest session files.

    Returns (installed, reason). Does nothing when Chrome crashed (its own
    file still has every window) or when that profile is already running.
    """
    if not enabled:
        return False, "disabled"
    if not user_data or not profile:
        return False, "no-profile"
    if running:
        return False, "already-running"
    kind = chromium_exit_kind(user_data, profile)
    # Crashed: Chrome's own file still lists every window. Anything else
    # (Normal, SessionEnded, unreadable) has usually dropped all but the last.
    if kind == "crashed":
        return False, "crashed-exit"
    if kind is None:
        return False, "exit-unknown"
    src = chrome_sidecar_dir(user_data, profile)
    session_src, tabs_src = os.path.join(src, "Session"), os.path.join(src, "Tabs")
    if not (snss_header_ok(session_src) and snss_header_ok(tabs_src)):
        return False, "no-snapshot"
    dest_dir = os.path.join(user_data, profile, "Sessions")
    try:
        os.makedirs(dest_dir, mode=0o700, exist_ok=True)
        names = os.listdir(dest_dir)
        stamp = next_session_stamp(names)
        session_dest = os.path.join(dest_dir, f"Session_{stamp}")
        tabs_dest = os.path.join(dest_dir, f"Tabs_{stamp}")
        try:
            _copy_private(session_src, session_dest)
            _copy_private(tabs_src, tabs_dest)
        except OSError:
            for path in (session_dest, tabs_dest):
                try:
                    os.unlink(path)
                except OSError:
                    pass
            raise
    except OSError as e:
        log(f"restore: chrome session install failed for profile {profile}: {e}")
        return False, "install-failed"
    log(f"restore: installed chrome session snapshot for profile {profile} (stamp {stamp})")
    return True, "installed"


def chromium_profile_is_running(user_data, profile):
    """True when a Chromium browser process for this profile is already up."""
    try:
        want = os.path.realpath(user_data)
    except OSError:
        return False
    try:
        entries = os.listdir("/proc")
    except OSError:
        return False
    for pid in entries:
        if not pid.isdigit():
            continue
        argv = cmdline(pid)
        if not argv or any(a.startswith("--type=") for a in argv):
            continue
        b = base(argv[0])
        if b not in CHROMIUM_USER_DATA:
            continue
        ud = chromium_user_data(b, "", argv)
        if not ud:
            continue
        try:
            if os.path.realpath(ud) != want:
                continue
        except OSError:
            continue
        got = None
        for a in argv:
            if a.startswith("--profile-directory="):
                got = a.split("=", 1)[1]
                break
        if got == profile or (got is None and profile == "Default"):
            return True
    return False


def with_restore_last_session(argv):
    """Ask Chromium to restore its session even if the startup pref would not."""
    if any(a == "--restore-last-session" or a.startswith("--restore-last-session=") for a in argv):
        return list(argv)
    b = base(argv[0]) if argv else ""
    if b not in CHROMIUM_USER_DATA:
        return list(argv)
    return list(argv) + ["--restore-last-session"]


def distinctive_name(title):
    """A window name specific enough to aim a workspace rule at one window."""
    key = browser_title_key(title)
    return bool(key) and len(key) >= 4 and key not in _GENERIC_TITLE


def window_name_score(saved, live):
    """How well a live window's name matches a saved one.

    xdgTag is the app's stable name. initialTitle is the name Hyprland
    recorded when the window was created; the live title often changes
    after that (unread counts, "Gmail" while a mailbox is still loading).
    """
    tag = (saved.get("xdg_tag") or "").strip()
    live_tag = (live.get("xdgTag") or live.get("xdg_tag") or "").strip()
    if tag and live_tag and tag == live_tag:
        return 1.0
    scores = [title_similarity(saved.get("title"), live.get("title"))]
    initial = saved.get("initial_title") or ""
    live_initial = live.get("initialTitle") or live.get("initial_title") or ""
    if distinctive_name(initial):
        scores.append(title_similarity(initial, live.get("title")))
        if distinctive_name(live_initial):
            scores.append(title_similarity(initial, live_initial))
    if distinctive_name(live_initial):
        scores.append(title_similarity(saved.get("title"), live_initial))
    return max(scores) if scores else 0.0


def match_windows_by_name(saved, clients, threshold=_TITLE_ACCEPT):
    """Pair saved windows to live ones by name. Returns (saved_i, client_i, score)."""
    scored = []
    for si, w in enumerate(saved):
        for ci, c in enumerate(clients):
            if (w.get("class") or "").lower() != (c.get("class") or "").lower():
                continue
            wp, cp = w.get("profile") or "", c.get("profile") or ""
            if wp and cp and wp != cp:
                continue
            scored.append((window_name_score(w, c), si, ci))
    used_s, used_c, pairs = set(), set(), []
    for score, si, ci in sorted(scored, key=lambda row: row[0], reverse=True):
        if score < threshold or si in used_s or ci in used_c:
            continue
        used_s.add(si)
        used_c.add(ci)
        pairs.append((si, ci, score))
    # A window still named "Gmail" or "JLCPCB" will not clear the strict
    # threshold against the full saved title. Take it when it is the only
    # window left for that class and profile.
    by_s, by_c = {}, {}
    for si, w in enumerate(saved):
        if si in used_s:
            continue
        by_s.setdefault(((w.get("class") or "").lower(), w.get("profile") or ""), []).append(si)
    for ci, c in enumerate(clients):
        if ci in used_c:
            continue
        cp = c.get("profile") or ""
        key_cls = (c.get("class") or "").lower()
        if cp:
            keys = [(key_cls, cp)]
        else:
            keys = [(cls, prof) for (cls, prof) in by_s if cls == key_cls]
            if len(keys) != 1:
                continue
        for key in keys:
            by_c.setdefault(key, []).append(ci)
    for key, sis in by_s.items():
        cis = by_c.get(key) or []
        if len(sis) != 1 or len(cis) != 1:
            continue
        si, ci = sis[0], cis[0]
        if ci in used_c or si in used_s:
            continue
        if not (only_candidate_match(saved[si].get("title"), clients[ci].get("title"))
                or only_candidate_match(saved[si].get("initial_title") or "", clients[ci].get("initialTitle") or clients[ci].get("title") or "")):
            continue
        used_s.add(si)
        used_c.add(ci)
        pairs.append((si, ci, window_name_score(saved[si], clients[ci])))
    return pairs


def title_regex(text):
    """Anchor a window name so a Hyprland regex matches that name only."""
    return "^" + re.escape(text or "") + "$"


def name_rule_specs(sess):
    """One workspace rule per distinct window name.

    A repeated name is skipped: two windows titled the same thing cannot
    both be sent to different workspaces by a single rule.
    """
    seen = {}
    for it in sess.get("items") or []:
        cls = it.get("class") or ""
        if not cls:
            continue
        for w in it.get("windows") or []:
            tag = (w.get("xdg_tag") or "").strip()
            initial = w.get("initial_title") or ""
            title = w.get("title") or ""
            if tag:
                field, value = "xdg_tag", tag
            elif distinctive_name(initial):
                field, value = "initial_title", initial
            elif distinctive_name(title):
                field, value = "initial_title", title
            else:
                continue
            ident = (cls.lower(), field, value)
            row = (cls, field, value, ws_selector(w))
            if ident in seen and seen[ident] != row:
                seen[ident] = None
            elif ident not in seen:
                seen[ident] = row
    specs = []
    for ident, row in seen.items():
        if not row:
            continue
        cls, field, value, ws = row
        specs.append({
            "name": f"omarchy-sr-{len(specs)}",
            "class": cls,
            "field": field,
            "pattern": title_regex(value),
            "label": value,
            "workspace": ws,
        })
    return specs


def lua_window_rule(spec):
    """Lua that tells Hyprland to open this named window on its workspace.

    The window name is inside the Lua source. Callers must send it over the
    Hyprland socket, not as a hyprctl argument: process arguments are visible
    to other local accounts, same as notify-send.
    """
    return (
        "hl.window_rule({ "
        f"name = {lua_long(spec['name'])}, "
        "match = { "
        f"class = {lua_long(title_regex(spec['class']))}, "
        f"{spec['field']} = {lua_long(spec['pattern'])} "
        "}, "
        f"workspace = {lua_long(str(spec['workspace']) + ' silent')} "
        "})"
    )


def lua_window_rule_off(name):
    return (
        "hl.window_rule({ "
        f"name = {lua_long(name)}, enabled = false, workspace = {lua_long('unset')} "
        "})"
    )


def hypr_eval(code, timeout=5):
    """Evaluate Lua inside Hyprland. The code is written to the user's socket,
    not placed on a process command line."""
    sig = instance_sig()
    if not sig:
        return 127, "no hyprland instance"
    rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    path = os.path.join(rt, "hypr", sig, ".socket.sock")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(path)
        s.sendall(("eval " + code).encode())
        try:
            s.shutdown(socket.SHUT_WR)
        except OSError:
            pass
        chunks = []
        while True:
            buf = s.recv(65536)
            if not buf:
                break
            chunks.append(buf)
        out = b"".join(chunks).decode(errors="replace")
    except OSError as e:
        return 127, str(e)
    finally:
        s.close()
    ok = "ok" in out.lower() and "error" not in out.lower()
    return (0 if ok else 1), out


def chromium_user_data(pbase, pexe, pargv, class_hint=""):
    """Absolute Chromium user-data dir for this browser process, or None."""
    for a in pargv or []:
        candidates = [a]
        if (" --" in a or a.count(" ") >= 2) and not a.startswith("--user-data-dir="):
            candidates = a.split()
        for tok in candidates:
            if tok.startswith("--user-data-dir="):
                d = os.path.expanduser(tok.split("=", 1)[1])
                return d if os.path.isdir(d) else None
    names = [pbase, base(strip_deleted(pexe)), base(pexe)]
    if class_hint:
        names.append(class_hint)
    cleaned = []
    for name in names:
        if not name:
            continue
        n = name[:-10] if name.endswith(" (deleted)") else name
        n = n.split()[0] if " " in n else n
        cleaned.append(n)
    for name in cleaned:
        rel = CHROMIUM_USER_DATA.get(name)
        if rel:
            d = os.path.join(XDG_CONFIG, rel)
            return d if os.path.isdir(d) else None
    # Last resort when exe/argv were mangled mid-upgrade but the window is Chrome.
    for name in cleaned:
        low = name.lower()
        if "google-chrome" in low or low in ("chrome", "google-chrome-stable"):
            d = os.path.join(XDG_CONFIG, "google-chrome")
            return d if os.path.isdir(d) else None
        if "chromium" in low:
            d = os.path.join(XDG_CONFIG, "chromium")
            return d if os.path.isdir(d) else None
    return None


def chromium_profile_dirs(user_data):
    """Ordered list of profile directory names from Local State (validated)."""
    try:
        with open(os.path.join(user_data, "Local State")) as f:
            ls = json.load(f)
    except (OSError, ValueError):
        return []
    prof = ls.get("profile") or {}
    order = list(prof.get("profiles_order") or [])
    info = prof.get("info_cache") or {}
    names = order or list(info.keys())
    out = []
    for n in names:
        if PROFILE_DIR_RE.fullmatch(n) and os.path.isdir(os.path.join(user_data, n)):
            out.append(n)
    return out


def chromium_profile_emails(user_data):
    """profile_dir → signed-in email (may be empty). Never returns tokens."""
    try:
        with open(os.path.join(user_data, "Local State")) as f:
            info = (json.load(f).get("profile") or {}).get("info_cache") or {}
    except (OSError, ValueError):
        return {}
    out = {}
    for n, p in info.items():
        if not PROFILE_DIR_RE.fullmatch(n) or not isinstance(p, dict):
            continue
        email = str(p.get("user_name") or "").strip()
        out[n] = email
    return out


def _chromium_session_titles(user_data, profile):
    """Title-like strings from the newest Session_*/Tabs_* files (UTF-8 and UTF-16LE)."""
    sd = os.path.join(user_data, profile, "Sessions")
    if not os.path.isdir(sd):
        return []
    files = sorted(
        (os.path.join(sd, f) for f in os.listdir(sd)
         if f.startswith("Session_") or f.startswith("Tabs_")),
        key=lambda p: os.path.getmtime(p), reverse=True)
    titles = set()
    for path in files[:4]:
        try:
            if os.path.getsize(path) > 8_000_000:
                continue
            data = open(path, "rb").read()
        except OSError:
            continue
        for m in re.finditer(rb"[ -~]{4,180}", data):
            titles.add(m.group().decode())
        for m in re.finditer(rb"(?:[\x20-\x7e]\x00){4,120}", data):
            try:
                titles.add(m.group().decode("utf-16-le"))
            except UnicodeDecodeError:
                pass
    return list(titles)


def match_chromium_profile(title, user_data, emails=None, title_cache=None):
    """Which profile directory owns this window title, or None."""
    if not title or not user_data:
        return None
    emails = emails if emails is not None else chromium_profile_emails(user_data)
    low = title.lower()
    for prof, email in emails.items():
        if email and email.lower() in low:
            return prof
    # Fall back to titles embedded in each profile's session/tabs files.
    # Score by the longest solid match so short tokens like "2026" or "YouTube"
    # can't tie two profiles at 1.0.
    if title_cache is None:
        title_cache = {}
    nt = norm_title(title)
    if not nt or len(nt) < 3:
        return None
    best, best_score, second = None, 0.0, 0.0
    for prof in chromium_profile_dirs(user_data):
        if prof not in title_cache:
            title_cache[prof] = _chromium_session_titles(user_data, prof)
        score = 0.0
        for st in title_cache[prof]:
            ns = norm_title(st)
            if not ns or len(ns) < 5:
                continue
            if nt == ns:
                score = max(score, 1000 + len(ns))
            elif ns in nt:
                # session string is a tab title contained in the window title
                score = max(score, 500 + len(ns))
            elif nt in ns:
                score = max(score, 400 + len(nt))
            else:
                r = difflib.SequenceMatcher(None, nt, ns).ratio()
                if r >= 0.85:
                    score = max(score, int(r * 300) + min(len(ns), len(nt)))
        if score > best_score:
            second, best_score, best = best_score, score, prof
        elif score > second:
            second = score
    if best and best_score >= 405 and best_score > second:
        return best
    return None


def with_profile_directory(argv, profile):
    """Return argv with --profile-directory set (and any prior value removed)."""
    if not profile or not PROFILE_DIR_RE.fullmatch(profile):
        return list(argv)
    out = [a for a in argv if not a.startswith("--profile-directory")]
    out.append("--profile-directory=" + profile)
    return out


def window_record(c):
    ws = c.get("workspace") or {}
    try:
        sid = int(str(c.get("stableId", "0")), 16)
    except ValueError:
        sid = 0
    grouped = c.get("grouped") or []
    return {
        "title": c.get("title", ""),
        # initialTitle is the name Hyprland saw when the window was created.
        # xdgTag is the app's own stable name (xdg-toplevel-tag), when it sets one.
        # Both survive a title that later grows an unread count.
        "initial_title": c.get("initialTitle") or "",
        "xdg_tag": c.get("xdgTag") or "",
        "workspace": ws.get("id"),
        "ws_name": ws.get("name", ""),
        "monitor": c.get("monitor"),
        "monitor_name": "",
        "monitor_identity": "",
        "floating": bool(c.get("floating")),
        "fullscreen": int(c.get("fullscreen") or 0),
        "pinned": bool(c.get("pinned")),
        "grouped": len(grouped) if isinstance(grouped, list) else 0,
        "at": c.get("at"),
        "size": c.get("size"),
        "stable": sid,
    }


def snapshot(cfg):
    clients = hypr_json("clients")
    monitors = hypr_json("monitors")
    desk = DesktopIndex()
    default_ids = default_terminal_ids()
    skip = [re.compile(p) for p in cfg["skip_classes"]]
    by_pid = {}
    skipped = []
    for c in clients:
        cls = c.get("class") or c.get("initialClass") or ""
        ws = (c.get("workspace") or {}).get("id")
        if not c.get("mapped", True) or c.get("hidden"):
            continue
        if not isinstance(ws, int):
            skipped.append((cls, "no workspace"))
            continue
        if ws <= 0 and not cfg.get("restore_special", True):
            skipped.append((cls, "special workspace"))
            continue
        if c.get("pid", 0) <= 0:
            skipped.append((cls, "no pid"))
            continue
        if any(p.fullmatch(cls) for p in skip):
            skipped.append((cls, "skip_classes"))
            continue
        mp = main_process(c["pid"])
        by_pid.setdefault(mp, []).append(c)

    items = []
    browsers = {}
    for pid, cs in by_pid.items():
        pargv, pexe = cmdline(pid), exe_of(pid)
        pbase = proc_basename(pargv, pexe)
        names = [pbase, base(pexe)]
        # group this process's windows by class
        classes = {}
        for c in cs:
            classes.setdefault(c.get("class") or c.get("initialClass") or "", []).append(c)
        for cls, wins in classes.items():
            wins.sort(key=lambda c: window_record(c)["stable"])
            desk_e = desk.for_class(cls, names)

            # ---- web app (chromium --app window with its own class)
            m = WEBAPP_CLASS.match(cls)
            if m and (pbase in BROWSER_BINS or base(pexe) in BROWSER_BINS or "chrome" in pexe):
                we = desk.webapp_for_class(cls)
                strategy = ""
                if we:
                    argv, strategy = list(we["argv"]), f"desktop file {we['id']}"
                else:
                    url = webapp_url_from_argv(pargv)
                    app = m.group("app")
                    chrome_bin = "google-chrome"
                    if pargv:
                        tok = pargv[0].split()[0] if (" " in pargv[0]) else pargv[0]
                        if tok and " " not in tok:
                            chrome_bin = tok
                    elif pexe:
                        chrome_bin = strip_deleted(pexe) or "google-chrome"
                    if not chrome_bin or " " in chrome_bin or chrome_bin.endswith(" (deleted)"):
                        chrome_bin = "google-chrome"
                    if not url and re.fullmatch(r"[a-p]{32}", app):
                        argv = [chrome_bin, f"--app-id={app}"]
                        strategy = "installed PWA app id"
                    else:
                        if not url:
                            host, _, path = app.partition("_")
                            url = "https://" + host + "/" + path.replace("_", "/").lstrip("/")
                        argv = [chrome_bin, f"--app={url}"]
                        strategy = "browser --app"
                    prof = m.group("profile")
                    if prof != "Default":
                        argv.append("--profile-directory=" + prof.replace("_", " "))
                for c in wins:
                    items.append({"kind": "webapp", "class": cls, "argv": argv,
                                  "strategy": strategy, "windows": [window_record(c)]})
                continue

            # ---- browser
            if (desk_e and "WebBrowser" in desk_e["cats"]) or pbase in BROWSER_BINS or base(pexe) in BROWSER_BINS:
                if desk_e and "WebBrowser" in desk_e["cats"]:
                    argv, strategy = list(desk_e["argv"]), f"desktop file {desk_e['id']}"
                else:
                    argv = [a for a in pargv if "://" not in a and not a.startswith(("--app=", "--app-id="))]
                    strategy = "process cmdline"
                # Strip a stale --profile-directory from the process cmdline; we set it per group.
                argv = [a for a in argv if not a.startswith("--profile-directory")]
                ud = chromium_user_data(pbase, pexe, pargv, class_hint=cls)
                emails = chromium_profile_emails(ud) if ud else {}
                title_cache = {}
                by_prof = {}
                for c in wins:
                    wr = window_record(c)
                    prof = None
                    # Prefer an explicit --profile-directory= on a per-window helper if present
                    # (rare on Linux; multi-profile usually shares one browser process).
                    if ud:
                        prof = match_chromium_profile(wr["title"], ud, emails, title_cache)
                    by_prof.setdefault(prof, []).append(wr)
                for prof, pwins in by_prof.items():
                    pargv2 = with_profile_directory(argv, prof) if prof else list(argv)
                    key = (cls, tuple(pargv2))
                    if key not in browsers:
                        label = f", profile {prof}" if prof else ""
                        browsers[key] = {
                            "kind": "browser", "class": cls, "argv": pargv2,
                            "profile": prof or "",
                            "strategy": (strategy + label +
                                         "; browser reopens this profile's windows, matched by title"),
                            "windows": [],
                        }
                        items.append(browsers[key])
                    browsers[key]["windows"] += pwins
                continue

            # ---- terminal
            term_key, spec = terminal_spec(cls, pbase, desk_e)
            if (term_key and spec and pbase in TERMINALS and cls not in spec["classes"]
                    and cls.lower() not in [x.lower() for x in spec["classes"]]
                    and not (desk_e and "TerminalEmulator" in desk_e["cats"])):
                # a TUI app running in its own terminal window with a custom class
                if len(classes) > 1:
                    skipped.append((cls, "custom-class window of a shared terminal process"))
                    continue
                items.append({"kind": "app", "class": cls, "argv": list(pargv),
                              "strategy": "process cmdline (terminal with custom class)",
                              "windows": [window_record(c) for c in wins]})
                continue
            if term_key and (spec is None or cls in spec["classes"] or
                             cls.lower() in [x.lower() for x in spec["classes"]] or
                             (desk_e and "TerminalEmulator" in desk_e["cats"])):
                tdesk = desk_e if (desk_e and "TerminalEmulator" in desk_e["cats"]) else None
                base_argv = terminal_base_argv(term_key, spec, pargv, tdesk)
                kids = children(pid)
                shells = [k for k in kids if is_shell(k)] or kids
                info = [shell_info(cfg, k) for k in shells]
                assigned = {}
                free = list(range(len(info)))
                if len(info) != len(wins):
                    # title -> cwd match first when counts disagree
                    for wi, c in enumerate(wins):
                        for path in title_paths(c.get("title", "")):
                            hits = [i for i in free if os.path.normpath(info[i]["cwd"]) == path]
                            if len(hits) == 1:
                                assigned[wi] = hits[0]
                                free.remove(hits[0])
                                break
                for wi in range(len(wins)):
                    if wi not in assigned and free:
                        assigned[wi] = free.pop(0)
                # Shells left over are tabs/splits. Nothing exposes which window a
                # tab belongs to, so attach each to the window whose first shell
                # started most recently before it (tabs are opened after their window).
                extra = {}
                prim = {wi: info[i]["start"] for wi, i in assigned.items()}
                for i in free:
                    st = info[i]["start"]
                    before = [wi for wi in prim if prim[wi] <= st]
                    if before:
                        extra.setdefault(max(before, key=lambda w: prim[w]), []).append(info[i])
                    elif prim:
                        extra.setdefault(min(prim, key=lambda w: prim[w]), []).append(info[i])
                for wi, c in enumerate(wins):
                    sh = info[assigned[wi]] if wi in assigned else {
                        "cwd": cwd_of(pid) or HOME, "resume": None, "label": "", "atuin": "", "hooked": False}
                    tabs = []
                    for t in [sh] + sorted(extra.get(wi, []), key=lambda t: t["start"]):
                        tabs.append({"cwd": t["cwd"], "atuin": t["atuin"], "hooked": t["hooked"],
                                     "resume": t["resume"], "label": t["label"],
                                     "argv": ensure_terminal_class(
                                         terminal_launch(term_key, spec, base_argv, t["cwd"], t["resume"],
                                                         default_ids, tdesk),
                                         cls, spec)})
                    plain = ensure_terminal_class(
                        terminal_launch(term_key, spec, base_argv, sh["cwd"], None, default_ids, tdesk),
                        cls, spec)
                    items.append({"kind": "terminal", "class": cls, "term": term_key,
                                  "argv": tabs[0]["argv"], "cwd": sh["cwd"], "resume": sh["resume"],
                                  "plain_argv": plain,
                                  "tabs": tabs,
                                  "strategy": f"{term_key} working-directory flag" if spec else "generic terminal",
                                  "windows": [window_record(c)]})
                continue

            # ---- everything else
            argv, strategy = None, ""
            fid = flatpak_id(pid)
            appimage = environ_var(pid, "APPIMAGE")
            if fid:
                argv, strategy = ["flatpak", "run", fid], "flatpak"
            elif appimage and os.path.exists(appimage):
                argv, strategy = [appimage] + pargv[1:], "AppImage"
            elif (pargv and os.path.isabs(pargv[0]) and os.access(pargv[0], os.X_OK)
                  and not pargv[0].startswith(("/tmp/", "/run/", "/proc/")) and not pexe.endswith(" (deleted)")):
                argv, strategy = list(pargv), "process cmdline"
            elif pargv and not os.path.isabs(pargv[0]) and shutil.which(pargv[0]):
                argv, strategy = list(pargv), "process cmdline"
            elif desk_e:
                argv, strategy = list(desk_e["argv"]), f"desktop file {desk_e['id']}"
            if not argv:
                skipped.append((cls, "no launch command found"))
                continue
            if len(wins) > 1:
                strategy += f"; launched once, {len(wins)} windows matched by title"
            items.append({"kind": "app", "class": cls, "argv": argv, "strategy": strategy,
                          "desktop_id": desk_e["id"] if desk_e else "",
                          "windows": [window_record(c) for c in wins]})

    display = display_fingerprint(monitors)
    mon_by_id = {m.get("id"): m for m in display["monitors"]}
    for it in items:
        for w in it.get("windows") or []:
            mid = w.get("monitor")
            meta = mon_by_id.get(mid) if isinstance(mid, int) else None
            if meta:
                w["monitor_name"] = meta.get("name") or ""
                w["monitor_identity"] = meta.get("identity") or ""
    workspaces = []
    try:
        for ws in hypr_json("workspaces"):
            wid = ws.get("id")
            if not isinstance(wid, int):
                continue
            if wid <= 0 and not cfg.get("restore_special", True):
                continue
            mmeta = None
            for m in display["monitors"]:
                if m.get("name") == ws.get("monitor") or m.get("id") == ws.get("monitorID"):
                    mmeta = m
                    break
            workspaces.append({
                "id": wid,
                "name": ws.get("name", ""),
                "monitor": ws.get("monitor"),
                "monitor_identity": (mmeta or {}).get("identity", ""),
                "tiledLayout": ws.get("tiledLayout") or "",
                "windows": ws.get("windows") or 0,
            })
    except Exception as e:
        log(f"snapshot: workspaces: {e!r}")
    return {
        "format": FORMAT,
        "version": VERSION,
        "saved_at": time.time(),
        "instance": instance_sig(),
        "boot_id": boot_id(),
        "display": display,
        "monitors": display["monitors"],
        "workspaces": workspaces,
        "items": items,
        "skipped": [{"class": c, "reason": r} for c, r in skipped],
    }


# ----------------------------------------------------------------- saving --
def frozen():
    try:
        with open(FREEZE) as f:
            return time.time() < float(f.read().strip())
    except (OSError, ValueError):
        return False


def shutting_down():
    rc, out = run(["systemctl", "is-system-running"], timeout=3)
    if out.strip() == "stopping":
        return True
    for d in os.listdir("/proc"):
        if d.isdigit():
            a = cmdline(d)
            for i, x in enumerate(a[:-1]):
                if base(x) == "omarchy-system" and a[i + 1] in ("reboot", "shutdown", "logout"):
                    return True
    return False


def windows_count(sess):
    return sum(len(i["windows"]) for i in sess.get("items", []))


def chrome_browser_profiles(sess):
    """Set of profile names on browser items (empty string if unset)."""
    out = set()
    for it in (sess or {}).get("items") or []:
        if it.get("kind") != "browser":
            continue
        cls = (it.get("class") or "").lower()
        if "chrome" not in cls and "chromium" not in cls:
            continue
        out.add(it.get("profile") or "")
    return out


def would_collapse_chrome_profiles(old, new):
    """True if new would replace split Chrome profiles with a profile='' mega-group."""
    if not old or not new:
        return False
    old_named = {p for p in chrome_browser_profiles(old) if p}
    new_named = {p for p in chrome_browser_profiles(new) if p}
    new_all = chrome_browser_profiles(new)
    if not old_named or new_named:
        return False
    if "" not in new_all and not new_all:
        return False
    old_n = sum(len(it.get("windows") or []) for it in old.get("items") or []
                if it.get("kind") == "browser")
    new_n = sum(len(it.get("windows") or []) for it in new.get("items") or []
                if it.get("kind") == "browser")
    return old_n >= 1 and new_n >= 1


def save(final=False, reason="manual"):
    cfg = load_config()
    if not cfg["enabled"]:
        log(f"save ({reason}): plugin disabled, not saving", echo=True)
        return 0
    ensure_dirs()
    with open_lock(SAVE_LOCK) as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        if not final:
            if frozen():
                log(f"save ({reason}): frozen after a final save, skipping")
                return 0
            if shutting_down():
                log(f"save ({reason}): system is shutting down, skipping")
                return 0
        cleanup_shell_files()
        sess = snapshot(cfg)
        n = windows_count(sess)
        if n == 0 and not final:
            log(f"save ({reason}): no windows, keeping previous session")
            return 0
        old = None
        try:
            with open(SESSION) as f:
                old = json.load(f)
        except (OSError, ValueError):
            pass
        if old and would_collapse_chrome_profiles(old, sess):
            log(f"save ({reason}): refusing collapsed Chrome profiles "
                f"(had {sorted(p for p in chrome_browser_profiles(old) if p)!r}, "
                f"new {sorted(chrome_browser_profiles(sess))!r}); keeping previous",
                echo=True)
            if final:
                atomic_write(FREEZE, str(time.time() + 120), 0o600)
                try:
                    copy_chromium_sessions(old)
                except Exception as e:
                    log(f"save: chrome session snapshot failed: {e!r}")
            return 0
        display = sess.get("display") or display_fingerprint()
        same = (old and old.get("items") == sess["items"] and old.get("instance") == sess["instance"]
                and (old.get("display") or {}).get("fingerprint") == display.get("fingerprint"))
        if same:
            os.utime(SESSION)
            msg = "unchanged"
        else:
            atomic_write(SESSION, json.dumps(sess, indent=1) + "\n", 0o600,
                         keep_prev=PREV if old else None)
            msg = "written"
        if cfg.get("per_display", True):
            try:
                save_layout_copy(sess, display)
                msg += f"; layout[{display.get('label', display.get('hash'))}]"
            except Exception as e:
                log(f"save: layout copy failed: {e!r}")
        else:
            remember_current_display(display)
        if final:
            atomic_write(FREEZE, str(time.time() + 120), 0o600)
        # Snapshot Chromium's own session on every real write, and always on
        # the final pre-logout save (even when the window list did not change).
        # That file still lists every window; Chrome's copy will not, once
        # logout closes the windows one by one.
        if final or not same:
            try:
                copy_chromium_sessions(sess)
            except Exception as e:
                log(f"save: chrome session snapshot failed: {e!r}")
        log(f"save ({reason}{', final' if final else ''}): {n} windows, {msg}", echo=not QUIET and reason == "manual")
        return 0



# ------------------------------------------------------ shell hook / tabs --
def make_queue(tabs):
    """Per-launch queue of tab states, claimed in order by session-hook.sh."""
    os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)
    fd, path = tempfile.mkstemp(dir=RUNTIME_DIR, prefix="queue-", suffix=".json")
    with os.fdopen(fd, "w") as f:
        json.dump({"created": time.time(), "claimed": 0,
                   "tabs": [{"cwd": t["cwd"], "atuin": t.get("atuin") or "", "resume": t.get("resume")}
                            for t in tabs]}, f)
    return path


def queue_claimed(path):
    try:
        with open(path) as f:
            return int(json.load(f).get("claimed", 0))
    except (OSError, ValueError, AttributeError):
        return 0


def wait_claims(path, n, timeout):
    end = time.time() + timeout
    while time.time() < end:
        if queue_claimed(path) >= n:
            return True
        time.sleep(0.15)
    return False


def shell_code(t):
    """Shell code for one restored tab. Every value is validated and quoted."""
    out = []
    cwd = t.get("cwd")
    if isinstance(cwd, str) and os.path.isdir(cwd):
        out.append(f"cd -- {shlex.quote(cwd)} 2>/dev/null")
    at = t.get("atuin") or ""
    if isinstance(at, str) and ATUIN_RE.fullmatch(at):
        out.append(f"export ATUIN_SESSION={at} ATUIN_SHLVL=\"$SHLVL\"")
    r = t.get("resume")
    if valid_argv(r):
        out.append("__osr_resume=(" + " ".join(shlex.quote(x) for x in r) + ")")
        out.append("__osr_arm")
    return "\n".join(out)


def claim_tab(path):
    real = os.path.realpath(path)
    if os.path.dirname(real) != os.path.realpath(RUNTIME_DIR) or not base(real).startswith("queue-"):
        return 2
    try:
        st = os.stat(real)
        if st.st_uid != os.getuid() or st.st_mode & 0o077 or time.time() - st.st_mtime > 600:
            return 2
        with open(real, "r+") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            q = json.load(f)
            i, tabs = int(q.get("claimed", 0)), q.get("tabs", [])
            if i >= len(tabs):
                return 0
            q["claimed"] = i + 1
            f.seek(0)
            f.truncate()
            json.dump(q, f)
    except (OSError, ValueError, AttributeError):
        return 1
    if isinstance(tabs[i], dict):
        print(shell_code(tabs[i]))
    return 0


def dbus_name_for_pid(pid):
    rc, out = run(["busctl", "--user", "list", "--no-legend"])
    if rc != 0:
        return None
    for ln in out.splitlines():
        f = ln.split()
        if len(f) > 1 and f[0].startswith(":") and f[1] == str(pid):
            return f[0]
    return None


def ghostty_window_path(name):
    rc, out = run(["gdbus", "introspect", "--session", "--dest", name, "--object-path", "/com/mitchellh/ghostty/window"])
    nodes = sorted(int(m) for m in re.findall(r"^\s*node (\d+)", out, re.M)) if rc == 0 else []
    return f"/com/mitchellh/ghostty/window/{nodes[-1]}" if nodes else None


def rc_files():
    out = []
    zd = os.environ.get("ZDOTDIR") or HOME
    for p in (os.path.join(HOME, ".bashrc"), os.path.join(zd, ".zshrc")):
        if os.path.isfile(p):
            out.append(p)
    return out


def hook_line():
    q = shlex.quote(HOOK_FILE)
    return f"[ -f {q} ] && . {q}  {HOOK_MARK}\n"


def hook_installed():
    if not os.path.isfile(HOOK_FILE):
        return False
    for rc in rc_files():
        try:
            with open(rc) as f:
                if HOOK_MARK in f.read():
                    return True
        except OSError:
            pass
    return False


def install_hook(args):
    files = rc_files()
    if not files:
        print("no ~/.bashrc or ~/.zshrc found")
        return 1
    for rc in files:
        with open(rc) as f:
            lines = f.readlines()
        if any(HOOK_MARK in ln for ln in lines):
            print(f"{rc}: hook already installed")
            continue
        at = [i for i, ln in enumerate(lines) if re.search(r"atuin\s+init", ln) and not ln.lstrip().startswith("#")]
        idx = at[-1] + 1 if at else len(lines)
        if lines and not lines[-1].endswith("\n"):
            lines[-1] += "\n"
        lines.insert(idx, hook_line())
        bak = rc + ".bak-session-restore-" + time.strftime("%Y%m%d-%H%M%S")
        shutil.copy2(rc, bak)
        atomic_write(rc, "".join(lines), mode=os.stat(rc).st_mode & 0o777)
        print(f"{rc}: hook added at line {idx + 1}" + (" (after atuin init)" if at else "") + f"; backup {bak}")
    print("New shells pick it up; already-open terminals keep working but are only fully tracked once restarted.")
    return 0


def uninstall_hook(args):
    for rc in rc_files():
        with open(rc) as f:
            lines = f.readlines()
        keep = [ln for ln in lines if HOOK_MARK not in ln]
        if len(keep) != len(lines):
            atomic_write(rc, "".join(keep), mode=os.stat(rc).st_mode & 0o777)
            print(f"{rc}: hook removed")
    return 0


# --------------------------------------------------------------- restore --
def load_session(path):
    st = os.stat(path)
    if st.st_uid != os.getuid():
        raise ValueError(f"{path} is not owned by you")
    if st.st_mode & 0o022:
        raise ValueError(f"{path} is group/world writable; refusing")
    with open(path) as f:
        sess = json.load(f)
    if not isinstance(sess, dict) or sess.get("format") != FORMAT or not isinstance(sess.get("items"), list):
        raise ValueError(f"{path}: unknown format")
    for it in sess["items"]:
        a = it.get("argv")
        if (not isinstance(a, list) or not a or not all(isinstance(x, str) and "\0" not in x for x in a)
                or it.get("kind") not in ("terminal", "browser", "webapp", "app")
                or not isinstance(it.get("windows"), list) or not it["windows"]):
            raise ValueError(f"{path}: invalid entry {str(it)[:120]}")
        if not valid_argv(it.get("plain_argv"), optional=True) or not isinstance(it.get("tabs", []), list):
            raise ValueError(f"{path}: invalid terminal entry {str(it)[:120]}")
        for t in it.get("tabs", []):
            if (not isinstance(t, dict) or not isinstance(t.get("cwd"), str) or not valid_argv(t.get("argv"))
                    or not valid_argv(t.get("resume"), optional=True) or not isinstance(t.get("atuin", ""), str)):
                raise ValueError(f"{path}: invalid tab {str(t)[:120]}")
    return sess


def valid_argv(a, optional=False):
    if a is None:
        return optional
    return isinstance(a, list) and bool(a) and all(isinstance(x, str) and "\0" not in x for x in a)


def filter_session(sess, workspaces):
    """Only the windows on the given workspaces (ids or names)."""
    want = set(str(w) for w in workspaces)
    def on(w):
        return ws_selector(w) in want or str(w.get("workspace")) in want or ("name:" + str(w.get("ws_name"))) in want
    items = []
    for it in sess["items"]:
        if it["kind"] == "browser":
            ws_ = [w for w in it["windows"] if on(w)]
            if ws_:
                items.append(dict(it, windows=ws_))
        elif on(it["windows"][0]):
            items.append(it)
    return dict(sess, items=items)


def sha_of(path):
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def hypr_uptime():
    """Seconds since this Hyprland instance started (None if unknown)."""
    try:
        for inst in hypr_json("instances"):
            if inst.get("instance") == instance_sig():
                st = stat_of(inst["pid"])["start"]
                with open("/proc/uptime") as f:
                    up = float(f.read().split()[0])
                return up - st / os.sysconf("SC_CLK_TCK")
    except Exception:
        pass
    return None


def pick_session(cfg, args):
    """Return (path, session, reason_to_skip_or_None, consume).

    consume=False when the path is a per-display layouts/ copy that must survive
    restore so the next dock/undock can find it again."""
    if args.file:
        return args.file, load_session(args.file), None, False
    if args.prev:
        if not os.path.exists(PREV):
            return None, None, "no previous session", True
        return PREV, load_session(PREV), None, True

    path, sess, consume = None, None, True
    display = display_fingerprint()
    match_kind = "legacy-session"
    if cfg.get("per_display", True):
        layout_path, match_kind = pick_layout_path(prefer_exact=True)
        if layout_path and layout_path != SESSION and os.path.exists(layout_path):
            try:
                layout_sess = load_session(layout_path)
            except (ValueError, OSError) as e:
                log(f"restore: layout {layout_path}: {e}")
                layout_sess = None
            if layout_sess is not None:
                # Prefer the layout when SESSION is missing, for another display
                # config, or absent entirely. Keep SESSION when it already matches.
                sess_fp = None
                if os.path.exists(SESSION):
                    try:
                        with open(SESSION) as f:
                            sess_fp = (json.load(f).get("display") or {}).get("fingerprint")
                    except (OSError, ValueError):
                        pass
                if sess_fp != display["fingerprint"]:
                    path, sess, consume = layout_path, layout_sess, False
                    log(f"restore: using per-display layout ({match_kind}) for {display['label']}")

    if sess is None:
        path = SESSION
        if not os.path.exists(path):
            # last resort: any layout
            layout_path, match_kind = pick_layout_path(prefer_exact=False)
            if layout_path and os.path.exists(layout_path):
                path, consume = layout_path, False
            else:
                return None, None, "no saved session", True
        try:
            sess = load_session(path)
        except (ValueError, OSError) as e:
            if path == SESSION and os.path.exists(PREV):
                log(f"restore: {e}; falling back to {PREV}")
                path, sess, consume = PREV, load_session(PREV), True
            else:
                raise

    reason = None
    age = time.time() - os.stat(path).st_mtime
    last = {}
    try:
        with open(LAST_RESTORE) as f:
            last = json.load(f)
    except (OSError, ValueError):
        pass
    if not cfg["enabled"]:
        reason = "plugin disabled"
    elif sess.get("instance") == instance_sig():
        reason = "session was saved by this same Hyprland session (nothing to restore)"
    elif age > cfg["max_age_hours"] * 3600:
        reason = f"session is stale ({fmt_age(age)} old > {cfg['max_age_hours']}h)"
    elif last.get("sha") == sha_of(path):
        reason = "this session was already restored"
    elif not args.dry_run:
        up = hypr_uptime()
        if up is not None and up > cfg["max_login_age_seconds"]:
            reason = f"Hyprland has been running {fmt_age(up)}; auto-restore only runs right after login"
    # Annotate how well the saved display matches the live one
    sess = dict(sess)
    sess["_display_match"] = match_kind if cfg.get("per_display", True) else "disabled"
    sess["_live_display"] = display
    return path, sess, reason, consume


def describe(sess, path):
    age = time.time() - os.stat(path).st_mtime if path and os.path.exists(path) else 0
    print(f"Session file: {path}")
    print(f"Saved {time.strftime('%Y-%m-%d %H:%M:%S %Z', time.localtime(sess.get('saved_at', 0)))}"
          f" (last confirmed {fmt_age(age)} ago), Hyprland instance {str(sess.get('instance'))[:12]}…,"
          f" {windows_count(sess)} windows in {len(sess['items'])} launch entries")
    disp = sess.get("display") or {}
    live = sess.get("_live_display") or {}
    if disp:
        print(f"Saved display: {disp.get('label') or disp.get('fingerprint')}"
              f" (match={sess.get('_display_match', '?')})")
    if live and live.get("fingerprint") != disp.get("fingerprint"):
        print(f"Live display:  {live.get('label') or live.get('fingerprint')}")
    wss = sess.get("workspaces") or []
    if wss:
        modes = ", ".join(f"{w.get('id')}:{w.get('tiledLayout') or '?'}" for w in wss if (w.get('id') or 0) > 0)
        if modes:
            print(f"Workspace layouts: {modes}")


def ordered_items(sess):
    items = sess["items"]
    def pos(it):
        w = it["windows"][0]
        at = w.get("at") or [0, 0]
        return (w.get("workspace") or 0, at[0], at[1])
    br = [i for i in items if i["kind"] == "browser"]
    mid = sorted([i for i in items if i["kind"] in ("terminal", "app")], key=pos)
    web = sorted([i for i in items if i["kind"] == "webapp"], key=pos)
    return br + mid + web


def primary_ws(it):
    counts = {}
    for w in it["windows"]:
        s = ws_selector(w)
        counts[s] = counts.get(s, 0) + 1
    return max(counts, key=lambda s: (counts[s], -it["windows"].index(next(w for w in it["windows"] if ws_selector(w) == s))))


def print_plan(sess):
    use_uwsm = bool(shutil.which("uwsm-app"))
    hooked = hook_installed()
    if not hooked:
        print("\nNote: the shell hook is not installed (omarchy-session install-hook), so terminals restore"
              " their cwd and program but get new Atuin sessions.")
    for n, it in enumerate(ordered_items(sess), 1):
        k = it["kind"]
        if k == "browser":
            ws = primary_ws(it)
            prof = it.get("profile") or ""
            who = f"profile {prof}" if prof else "default profile"
            print(f"\n{n}. browser [{it['class']}] — launch {who} on workspace {ws}, "
                  f"then place {len(it['windows'])} reopened windows by title ({it['strategy']}):")
            for w in it["windows"]:
                print(f"     ws {ws_selector(w):>3}  {'floating ' if w['floating'] else ''}\"{w['title'][:70]}\"")
            print("     (skipped only if this profile's windows are already open)")
            if prof and it.get("argv"):
                ud = chromium_user_data(base(it["argv"][0]), "", it["argv"])
                side = chrome_sidecar_dir(ud, prof) if ud else ""
                if side and os.path.isfile(os.path.join(side, "Session")):
                    print("     a clean exit restores this profile from the pre-logout Chrome session snapshot")
        else:
            w = it["windows"][0]
            extra = ""
            if k == "terminal" and not it.get("tabs"):
                extra = f", cwd {it.get('cwd')}" + (f", resumes: {shlex.join(it['resume'])}" if it.get("resume") else "")
            print(f"\n{n}. {k} [{it['class']}] → workspace {ws_selector(w)}{extra} ({it['strategy']})")
            for w2 in it["windows"]:
                print(f"     ws {ws_selector(w2):>3}  {'floating ' if w2['floating'] else ''}\"{w2['title'][:70]}\"")
            if k in ("app", "webapp"):
                print("     (an existing window with this class is claimed instead of launching)")
            if k == "terminal" and it.get("tabs"):
                tabs = it["tabs"]
                how = ""
                if len(tabs) > 1:
                    how = (" (opened as tabs of one window)" if it.get("term") == "ghostty" and hooked
                           else " (extra tabs open as separate windows on the same workspace)")
                print(f"     {len(tabs)} tab{'s' if len(tabs) > 1 else ''}{how}:")
                for ti, t in enumerate(tabs, 1):
                    at = ("Atuin session …" + t["atuin"][-12:]) if t.get("atuin") and hooked else \
                         ("new Atuin session" + ("" if hooked else " (shell hook not installed)"))
                    print(f"       tab {ti}: cwd {t['cwd']}; {at}")
                    if t.get("resume"):
                        print(f"              runs: {shlex.join(t['resume'])}" + (f"   [{t['label']}]" if t.get("label") else ""))
                if hooked:
                    print("     $ env OMARCHY_SR_QUEUE=<per-restore queue> " + shlex.join(it.get("plain_argv") or it["argv"]))
                    continue
        print("     $ " + shlex.join(it["argv"]))
        print("     dispatch: " + exec_dispatch_string(it["argv"], primary_ws(it) if k == "browser" else ws_selector(it["windows"][0]), use_uwsm))
    if sess.get("skipped"):
        print("\nNot saved: " + ", ".join(f"{s['class']} ({s['reason']})" for s in sess["skipped"]))



def relayout_existing(sess, cfg=None):
    """Re-place already-open windows to match a saved layout (hotplug path).

    Does not launch apps. Used when the display configuration changes and a
    remembered layout for the new fingerprint exists."""
    cfg = cfg or load_config()
    r = Restorer(cfg)
    r.sess = sess
    r.monitors_now = hypr_json("monitors")
    r.known = set()  # claim any existing window
    try:
        apply_workspace_layouts(sess)
    except Exception as e:
        log(f"relayout: workspace layouts: {e!r}")
    live = r.clients()
    placed = 0
    for it in sess.get("items") or []:
        cls = it.get("class") or ""
        for w in it.get("windows") or []:
            cands = [c for c in live
                     if c["address"] not in r.claimed
                     and (c.get("class") or c.get("initialClass") or "").lower() == cls.lower()]
            if not cands:
                continue
            best = max(cands, key=lambda c: title_similarity(w.get("title"), c.get("title")))
            score = title_similarity(w.get("title"), best.get("title"))
            if score < _TITLE_ACCEPT and not (len(cands) == 1 and only_candidate_match(w.get("title"), best.get("title"))):
                continue
            r.place(best, w)
            placed += 1
    try:
        r.reorder_tiled(sess)
    except Exception as e:
        log(f"relayout: reorder: {e!r}")
    log(f"relayout: placed {placed} existing windows for "
        f"{(sess.get('display') or {}).get('label', '?')}")
    return placed


class Restorer:
    def __init__(self, cfg):
        self.cfg = cfg
        self.use_uwsm = bool(shutil.which("uwsm-app"))
        self.known = {c["address"] for c in hypr_json("clients")}   # windows present before restore
        self.claimed = set()
        self.pending = []   # browser/app groups waiting for more windows
        self.placed = 0
        self.failed = []
        self.placed_at = {}    # address → saved window, for layout rebuild
        self._prof_cache = {}
        self.hooked = hook_installed()
        self.refocus = None
        try:
            self.prev_focus = (hypr_json("activewindow") or {}).get("address")
        except Exception:
            self.prev_focus = None

    def clients(self):
        try:
            return hypr_json("clients")
        except Exception:
            return []

    def unclaimed(self, cls, include_known=False):
        out = []
        for c in self.clients():
            if c["address"] in self.claimed:
                continue
            if c["address"] in self.known and not include_known:
                continue
            if (c.get("class") or c.get("initialClass") or "").lower() == cls.lower():
                out.append(c)
        return out

    def launch(self, argv, ws):
        a = list(argv)
        if a[0] not in ("env",) and not os.path.isabs(a[0]) and not shutil.which(a[0]):
            log(f"restore: {a[0]} not found, skipping")
            return False
        return dispatch(exec_dispatch_string(a, ws, self.use_uwsm))

    def place(self, c, w):
        addr = "address:" + c["address"]
        L = lua_long
        self.claimed.add(c["address"])
        monitors_now = getattr(self, "monitors_now", None) or hypr_json("monitors")
        w = clamp_floating(w, monitors_now, (getattr(self, "sess", {}) or {}).get("monitors") or [])
        self.placed_at[c["address"]] = w
        mid = w.get("monitor_identity") or w.get("monitor_name")
        mon_name = resolve_monitor_name(mid, monitors_now)
        wid = w.get("workspace")
        if mon_name and isinstance(wid, int) and wid > 0:
            try:
                for ws in hypr_json("workspaces"):
                    if ws.get("id") == wid and ws.get("monitor") != mon_name:
                        move_workspace_to_monitor(wid, mon_name)
                        break
            except Exception:
                pass
        cls = c.get("class") or c.get("initialClass") or "?"
        if not self._move_to_workspace(c, w, cls):
            # Count it so the notification says the restore was incomplete.
            # The class name is not a window title.
            self.failed.append(cls)
        fresh = self._client(c["address"]) or c
        if bool(fresh.get("floating")) != bool(w.get("floating")):
            dispatch(f"hl.dsp.window.float({{ action = {L('on' if w['floating'] else 'off')}, window = {L(addr)} }})")
        if w.get("floating") and w.get("size") and w.get("at"):
            dispatch(f"hl.dsp.window.resize({{ x = {int(w['size'][0])}, y = {int(w['size'][1])}, window = {L(addr)} }})")
            dispatch(f"hl.dsp.window.move({{ x = {int(w['at'][0])}, y = {int(w['at'][1])}, window = {L(addr)} }})")
        if w.get("fullscreen") and not fresh.get("fullscreen"):
            mode = "maximized" if w["fullscreen"] == 1 else "fullscreen"
            dispatch(f"hl.dsp.window.fullscreen({{ mode = {L(mode)}, window = {L(addr)} }})")
        if w.get("pinned") and w.get("floating") and not fresh.get("pinned"):
            dispatch(f"hl.dsp.window.pin({{ window = {L(addr)} }})")
        self.placed += 1

    def _client(self, address):
        for c in self.clients():
            if c.get("address") == address:
                return c
        return None

    def _client_ws(self, c):
        cur = (c or {}).get("workspace") or {}
        return ws_selector({"workspace": cur.get("id"), "ws_name": cur.get("name", "")})

    def _layout(self, ws_id):
        """Live layout name for a workspace id, else the saved one."""
        try:
            for ws in hypr_json("workspaces"):
                if ws.get("id") == ws_id and ws.get("tiledLayout"):
                    return str(ws.get("tiledLayout")).lower()
        except Exception:
            pass
        for ws in (getattr(self, "sess", None) or {}).get("workspaces") or []:
            if ws.get("id") == ws_id:
                return str(ws.get("tiledLayout") or "").lower()
        return ""

    def _focus(self, address):
        self.refocus = True
        return dispatch(f"hl.dsp.focus({{ window = {lua_long('address:' + address)} }})")

    def _layout_msg(self, message):
        return dispatch(f"hl.dsp.layout({lua_long(message)})")

    def _move_to_workspace(self, c, w, cls):
        """Move one window onto its saved workspace and check that it stuck.

        On the scrolling layout a column can contain several windows. Moving
        the column would drag the others along and pile every window onto the
        last workspace, so a shared column is split before the move.
        """
        target = ws_selector(w)
        addr = c["address"]
        cur_c = self._client(addr) or c
        current = self._client_ws(cur_c)
        if current == target:
            log(f"restore: workspace keep class={cls} addr={addr} workspace={target}")
            return True
        ws_id = (cur_c.get("workspace") or {}).get("id")
        layout = self._layout(ws_id) if isinstance(ws_id, int) else ""
        if layout == "scrolling":
            self._split_scrolling_column(addr, cls)
        log(f"restore: workspace move class={cls} addr={addr} {current} -> {target} via window.move")
        sel = lua_long("address:" + addr)
        dispatch(f"hl.dsp.window.move({{ workspace = {lua_long(target)}, follow = false, window = {sel} }})")
        now = self._client(addr)
        got = self._client_ws(now) if now else ""
        if got == target:
            log(f"restore: workspace move class={cls} addr={addr} now on {got}")
            return True
        log(f"restore: workspace move class={cls} addr={addr} still on {got or '?'}; retrying focused")
        self._focus(addr)
        dispatch(f"hl.dsp.window.move({{ workspace = {lua_long(target)}, follow = false, window = {sel} }})")
        now = self._client(addr)
        got = self._client_ws(now) if now else ""
        if got == target:
            log(f"restore: workspace move class={cls} addr={addr} now on {got} after focus")
            return True
        # Numeric id "5" and the workspace's name are not always the same
        # selector. Retry with the saved workspace name before giving up.
        ws_name = str(w.get("ws_name") or "").strip()
        if ws_name and not str(target).startswith("name:") and not str(target).startswith("special:"):
            named = "name:" + ws_name
            log(f"restore: workspace move class={cls} addr={addr} retry by workspace name {named}")
            self._focus(addr)
            dispatch(f"hl.dsp.window.move({{ workspace = {lua_long(named)}, follow = false, window = {sel} }})")
            now = self._client(addr)
            got = self._client_ws(now) if now else ""
            if got == target or got == named or (now and str((now.get("workspace") or {}).get("name") or "") == ws_name):
                log(f"restore: workspace move class={cls} addr={addr} now on {got or ws_name} via name")
                return True
        # Last resort when this window is already alone in its scrolling column.
        # movecoltoworkspace moves the whole column; using it on a shared column
        # would drag the other windows onto this workspace and pile them up.
        now_layout = self._layout((now.get("workspace") or {}).get("id")) if now else layout
        if now_layout == "scrolling" or layout == "scrolling":
            if self._alone_in_column(addr):
                self._focus(addr)
                self._layout_msg("movecoltoworkspace " + target)
                now = self._client(addr)
                got = self._client_ws(now) if now else ""
                if got == target:
                    log(f"restore: workspace move class={cls} addr={addr} now on {got} via movecoltoworkspace")
                    return True
            else:
                log(f"restore: workspace move class={cls} addr={addr} skipped movecoltoworkspace "
                    "(other windows share its column)")
        live_layout = self._layout((now.get("workspace") or {}).get("id")) if now else layout
        log(f"restore: workspace move FAILED class={cls} addr={addr} wanted {target} still {got or '?'} layout={live_layout or layout or '?'}")
        return False

    def _alone_in_column(self, address):
        me = self._client(address)
        if not me:
            return False
        ws_id = (me.get("workspace") or {}).get("id")
        if self._layout(ws_id) != "scrolling":
            return False
        x = (me.get("at") or [0])[0]
        for c in self.clients():
            if c.get("address") == address or c.get("floating"):
                continue
            if (c.get("workspace") or {}).get("id") != ws_id:
                continue
            if abs(((c.get("at") or [0])[0]) - x) <= _COLUMN_X_SLACK:
                return False
        return True

    def _split_scrolling_column(self, address, cls):
        """Give this window its own scrolling column when it shares one."""
        for _ in range(6):
            me = self._client(address)
            if not me or me.get("floating"):
                return
            ws_id = (me.get("workspace") or {}).get("id")
            if self._layout(ws_id) != "scrolling":
                return
            x = (me.get("at") or [0])[0]
            mates = []
            for c in self.clients():
                if c.get("address") == address or c.get("floating"):
                    continue
                if (c.get("workspace") or {}).get("id") != ws_id:
                    continue
                if abs(((c.get("at") or [0])[0]) - x) <= _COLUMN_X_SLACK:
                    mates.append(c["address"])
            if not mates:
                return
            before = x
            self._focus(address)
            self._layout_msg("promote")
            time.sleep(0.05)
            me = self._client(address)
            nx = ((me or {}).get("at") or [0])[0]
            if abs(nx - before) > _COLUMN_X_SLACK:
                log(f"restore: split scrolling column class={cls} addr={address} via promote")
                continue
            self._layout_msg("expel")
            time.sleep(0.05)
            me = self._client(address)
            nx = ((me or {}).get("at") or [0])[0]
            if abs(nx - before) > _COLUMN_X_SLACK:
                log(f"restore: split scrolling column class={cls} addr={address} via expel")
                continue
            log(f"restore: could not split scrolling column class={cls} addr={address} shared_with={len(mates)}")
            return

    def _process_profile(self, c):
        """--profile-directory from the browser process, if it can be read."""
        pid = c.get("pid") or 0
        if not pid:
            return ""
        if pid in self._prof_cache:
            return self._prof_cache[pid]
        mp = main_process(pid)
        prof = profile_from_argv(cmdline(mp))
        self._prof_cache[pid] = prof
        self._prof_cache[mp] = prof
        return prof

    def _profile_of_client(self, c):
        cls = c.get("class") or c.get("initialClass") or ""
        return client_profile(
            self._process_profile(c), cls,
            saved_browser_profiles(getattr(self, "sess", None), cls))

    def _match_client(self, c):
        return {
            "address": c.get("address"),
            "title": c.get("title") or "",
            "profile": self._profile_of_client(c),
            "class": c.get("class") or c.get("initialClass") or "",
            "raw": c,
        }

    def wait_new(self, cls, timeout):
        end = time.time() + timeout
        while time.time() < end:
            new = self.unclaimed(cls)
            if new:
                return new[0]
            self.step_pending(final=False)
            time.sleep(0.25)
        return None

    def step_pending(self, final):
        progressed = False
        for g in list(self.pending):
            raw = self.unclaimed(g["class"])
            cands = [self._match_client(c) for c in raw]
            remaining = g["remaining"]
            browser = g.get("kind") == "browser"
            done = time.time() > g.get("deadline", 0) or final
            if cands and remaining:
                pairs, notes = match_saved_windows(
                    remaining, cands, g.get("profile") or "", desperate=done and not browser)
                g["last_notes"] = notes
                matched = {wi for wi, _, _ in pairs}
                for wi, ci, score in pairs:
                    self.place(cands[ci]["raw"], remaining[wi])
                    progressed = True
                    log(f"restore: matched class={g['class']} profile={g.get('profile') or '-'} "
                        f"score={score:.2f} workspace={ws_selector(remaining[wi])} "
                        f"title={clip_title(remaining[wi].get('title'))!r}")
                g["remaining"] = [w for wi, w in enumerate(remaining) if wi not in matched]
            if g["remaining"] and not done:
                continue
            self._claim_group_leftovers(g)
            if g["remaining"]:
                summary = note_unmatched_windows(
                    self.failed, g["class"], g["remaining"], g.get("last_notes"), g.get("profile") or "")
                log(summary, echo=True)
            self.pending.remove(g)
        return progressed

    def _claim_group_leftovers(self, g):
        # Do not swallow windows another profile's group still needs to place.
        others = any(
            p is not g and p.get("class") == g.get("class") and p.get("remaining")
            for p in self.pending)
        clients = [self._match_client(c) for c in self.unclaimed(g["class"])]
        for addr in leftover_claim_ids(g.get("profile") or "", g["class"], others, clients):
            self.claimed.add(addr)

    def _reopen_target(self, g):
        """Window that should receive Ctrl+Shift+T for this profile.

        With several Chrome profiles in one process, the process profile is
        unknown. Pick a window whose title belongs to this profile. Sending
        the shortcut to the other profile's window restores the wrong session.
        """
        want = g.get("profile") or ""
        titles = [w.get("title") or "" for w in (g.get("windows") or g.get("remaining") or [])]
        best, best_s = None, 0.0
        for c in self.clients():
            if (c.get("class") or c.get("initialClass") or "").lower() != (g.get("class") or "").lower():
                continue
            cp = self._profile_of_client(c)
            if want and cp and cp != want:
                continue
            score = 0.0
            for title in titles:
                score = max(score, title_similarity(title, c.get("title")),
                            title_similarity(title, c.get("initialTitle")))
            if want and cp == want and score >= best_s:
                best, best_s = c, max(score, best_s)
            elif not cp and score > best_s:
                best, best_s = c, score
        if best is None:
            return None
        if best_s >= 0.5 or (want and self._profile_of_client(best) == want):
            return best
        return None

    def _reopen_closed_window(self, g):
        """Ctrl+Shift+T — Chrome's reopen-closed-window shortcut — once.

        This is the same action as History → recently closed. It runs only
        after new windows have stopped appearing, and only for still-missing
        saved windows. Stops if the key does not create a new toplevel, so a
        restored tab is not pulled into a window we already placed.
        """
        if g.get("reopen_stop"):
            return False
        target = self._reopen_target(g)
        if not target:
            log(f"restore: reopen skipped class={g.get('class')} profile={g.get('profile') or '-'} "
                "(no window of this profile to send the shortcut to)")
            g["reopen_stop"] = True
            return False
        before = {c.get("address") for c in self.clients()}
        self._focus(target["address"])
        addr = lua_long("address:" + target["address"])
        dispatch(f"hl.dsp.send_shortcut({{ mods = {lua_long('CTRL SHIFT')}, key = {lua_long('T')}, window = {addr} }})")
        log(f"restore: reopen closed window class={g.get('class')} profile={g.get('profile') or '-'} "
            f"attempt={g.get('reopen_attempts', 0) + 1} missing={len(g.get('remaining') or [])}")
        end = time.time() + 3
        while time.time() < end:
            time.sleep(0.25)
            new = [c for c in self.clients()
                   if c.get("address") not in before
                   and (c.get("class") or c.get("initialClass") or "").lower() == (g.get("class") or "").lower()]
            if new:
                return True
        log(f"restore: reopen produced no new {g.get('class')} window for profile {g.get('profile') or '-'}; stopping")
        g["reopen_stop"] = True
        return False

    def _extend_browser_deadlines(self):
        """Keep waiting while Chrome is still creating windows, up to the cap."""
        now = time.time()
        settle = max(1, int(self.cfg.get("browser_settle_seconds", 12)))
        for g in self.pending:
            if g.get("kind") != "browser":
                continue
            cap = g.get("deadline_cap", g.get("deadline", now))
            g["deadline"] = min(cap, max(g.get("deadline", now), now + settle))

    def wait_pending(self):
        settle = max(1, int(self.cfg.get("browser_settle_seconds", 12)))
        last_addrs = {c.get("address") for c in self.clients()}
        last_change = time.time()
        while self.pending:
            self.step_pending(final=False)
            if not self.pending:
                break
            addrs = {c.get("address") for c in self.clients()}
            changed = addrs != last_addrs
            if changed:
                last_change = time.time()
                last_addrs = addrs
                self._extend_browser_deadlines()
            names = tuple(sorted(
                (c.get("address"), c.get("title") or "", (c.get("workspace") or {}).get("id"))
                for c in self.clients()))
            if names != getattr(self, "_name_sig", None):
                self._name_sig = names
                self.place_named_windows()
            if not changed and time.time() - last_change >= settle:
                for g in list(self.pending):
                    if g.get("kind") != "browser" or g.get("reopen_stop"):
                        continue
                    if time.time() <= g.get("reopen_after", 0) or time.time() > g.get("deadline", 0):
                        continue
                    if g.get("reopen_attempts", 0) >= g.get("reopen_budget", 0):
                        g["reopen_stop"] = True
                        continue
                    if not g.get("remaining"):
                        continue
                    opened = self._reopen_closed_window(g)
                    g["reopen_attempts"] = g.get("reopen_attempts", 0) + 1
                    if opened:
                        last_change = time.time()
                        last_addrs = {c.get("address") for c in self.clients()}
                    break
            time.sleep(0.4)

    def _live_xs(self, addrs):
        out = {}
        live = {c["address"]: c for c in self.clients()}
        for a in addrs:
            c = live.get(a) or {}
            at = c.get("at") or [0]
            out[a] = at[0] if at else 0
        return out

    def _order_is_spread(self, desired):
        """True when left-to-right x order matches `desired` and columns are distinct."""
        xs = self._live_xs(desired)
        # Lexicographic address order as the tie input, so equal x values do not
        # look "already sorted" just because Python's sort is stable.
        actual = sorted(desired, key=lambda a: (xs.get(a, 0), a))
        if actual != desired and inversion_index(actual, desired) is not None:
            return False
        if actual != desired:
            return False
        ordered = sorted(xs.get(a, 0) for a in desired)
        return all(ordered[i + 1] - ordered[i] > _COLUMN_X_SLACK for i in range(len(ordered) - 1))

    def reorder_tiled(self, sess):
        """Put tiled windows left to right in saved order.

        Directional ``window.swap`` (swap right) is not used. On the scrolling
        layout Hyprland answers "No window to swap with in that direction" and
        a bubble-sort retries that same swap until it gives up, leaving the
        windows stacked in one column. Scrolling windows are split into their
        own columns and ordered with ``swapcol``. Other layouts swap the two
        specific windows that are out of order.
        """
        del sess  # order comes from windows place() actually moved
        live = {c["address"]: c for c in self.clients()}
        by_ws = {}
        for addr, saved in self.placed_at.items():
            if not isinstance(saved, dict) or saved.get("floating") or not saved.get("at"):
                continue
            c = live.get(addr)
            if not c or c.get("floating"):
                continue
            ws = (c.get("workspace") or {}).get("id")
            if not isinstance(ws, int):
                continue
            by_ws.setdefault(ws, {})[addr] = saved["at"][0]
        for ws, xpos in by_ws.items():
            if len(xpos) < 2:
                continue
            desired = [a for a, _x in sorted(xpos.items(), key=lambda t: (t[1], t[0]))]
            self._order_workspace(ws, desired)

    def _order_workspace(self, ws, desired):
        layout = self._layout(ws)
        log(f"restore: order workspace {ws} layout={layout or '?'} windows={len(desired)}")
        if layout == "scrolling":
            self._order_scrolling(ws, desired)
        else:
            self._order_by_target_swap(ws, desired, layout)

    def _order_by_target_swap(self, ws, desired, layout):
        for _ in range(max(1, len(desired) * len(desired))):
            if self._order_is_spread(desired):
                log(f"restore: order workspace {ws} layout={layout or '?'} ok")
                return
            xs = self._live_xs(desired)
            actual = sorted(desired, key=lambda a: (xs.get(a, 0), a))
            i = inversion_index(actual, desired)
            if i is None:
                log(f"restore: order workspace {ws} layout={layout or '?'} "
                    "windows still share a column; target swap has no inversion to fix")
                return
            left, right = actual[i], actual[i + 1]
            before = dict(xs)
            dispatch(
                f"hl.dsp.window.swap({{ target = {lua_long('address:' + right)}, "
                f"window = {lua_long('address:' + left)} }})"
            )
            time.sleep(0.05)
            if self._live_xs(desired) == before:
                log(f"restore: order workspace {ws} layout={layout or '?'} "
                    f"target swap made no progress left={left} right={right}")
                return
        log(f"restore: order workspace {ws} layout={layout or '?'} stopped after max swaps")

    def _order_scrolling(self, ws, desired):
        rank = {a: i for i, a in enumerate(desired)}
        for _ in range(len(desired) * 2):
            if self._order_is_spread(desired):
                break
            xs = self._live_xs(desired)
            split = False
            for group in column_groups([(a, xs.get(a, 0)) for a in desired]):
                if len(group) < 2:
                    continue
                addr = max(group, key=lambda t: rank.get(t[0], 0))[0]
                self._focus(addr)
                self._layout_msg("promote")
                time.sleep(0.05)
                log(f"restore: order workspace {ws} promote addr={addr} out of a shared column")
                split = True
                break
            if not split:
                break
        if not self._order_is_spread(desired):
            for _ in range(len(desired) * len(desired)):
                if self._order_is_spread(desired):
                    break
                xs = self._live_xs(desired)
                actual = sorted(desired, key=lambda a: (xs.get(a, 0), a))
                i = inversion_index(actual, desired)
                if i is None:
                    break
                left = actual[i]
                before = dict(xs)
                self._focus(left)
                self._layout_msg("swapcol r")
                time.sleep(0.05)
                if self._live_xs(desired) == before:
                    log(f"restore: order workspace {ws} layout=scrolling swapcol made no progress "
                        f"addr={left}; trying target swap")
                    self._order_by_target_swap(ws, desired, "scrolling")
                    return
        if self._order_is_spread(desired):
            log(f"restore: order workspace {ws} layout=scrolling ok")
        else:
            log(f"restore: order workspace {ws} layout=scrolling FAILED "
                "(windows still share a column or left-to-right order disagrees)")

    def _install_name_rules(self, sess):
        """Ask Hyprland to open each named window on its saved workspace.

        The rule matches the window's name (xdg tag, or the title Hyprland
        sees at creation). It is installed before anything is launched, so a
        Chrome window that appears late still lands on workspace 4 instead of
        the workspace that happens to be showing. Rules are removed at the end.
        """
        self._rule_names = []
        hypr_eval(
            "for i = 0, 31 do "
            "hl.window_rule({ name = 'omarchy-sr-' .. i, enabled = false, workspace = 'unset' }) "
            "end"
        )
        specs = name_rule_specs(sess)
        if not specs:
            log("restore: no distinctive window names for workspace rules")
            return
        for spec in specs:
            rc, _out = hypr_eval(lua_window_rule(spec))
            self._rule_names.append(spec["name"])
            # The name itself stays in the mode-600 log, not in a notification
            # and not on a process command line.
            if rc == 0:
                log(f"restore: name rule {spec['name']} class={spec['class']} "
                    f"by {spec['field']} name={clip_title(spec.get('label') or '')!r} "
                    f"-> workspace {spec['workspace']}")
            else:
                log(f"restore: name rule {spec['name']} failed ({rc}); will place by name after the window appears")

    def _clear_name_rules(self):
        names = list(getattr(self, "_rule_names", []) or [])
        if not names:
            return
        body = " ".join(lua_window_rule_off(name) for name in names)
        hypr_eval(body)
        self._rule_names = []

    def place_named_windows(self):
        """Move windows that are still on the wrong workspace, matched by name.

        This runs again whenever a title changes, so a window that opened on
        workspace 1 as \"Gmail\" and later became the real mailbox is moved
        once its name is recognizable.
        """
        sess = getattr(self, "sess", None)
        if not sess:
            return 0
        saved = []
        for it in sess.get("items") or []:
            cls = it.get("class") or ""
            prof = it.get("profile") or ""
            for w in it.get("windows") or []:
                saved.append({
                    "class": cls, "profile": prof, "window": w,
                    "title": w.get("title") or "",
                    "initial_title": w.get("initial_title") or "",
                    "xdg_tag": w.get("xdg_tag") or "",
                })
        live = []
        for c in self.clients():
            live.append({
                "address": c.get("address"),
                "title": c.get("title") or "",
                "initialTitle": c.get("initialTitle") or "",
                "xdgTag": c.get("xdgTag") or "",
                "class": c.get("class") or c.get("initialClass") or "",
                "profile": self._profile_of_client(c),
                "raw": c,
            })
        moved = 0
        tried = getattr(self, "_name_tried", None)
        if tried is None:
            self._name_tried = tried = set()
        for si, ci, score in match_windows_by_name(saved, live):
            w = saved[si]["window"]
            raw = live[ci]["raw"]
            addr = raw.get("address")
            target = ws_selector(w)
            cur = self._client_ws(raw)
            if cur == target:
                continue
            # One attempt per live title. A loading name ("Gmail") and the
            # later mailbox name each get a move; a 150s wait does not repeat.
            attempt = (addr, target, raw.get("title") or "")
            if attempt in tried:
                continue
            tried.add(attempt)
            cls = saved[si]["class"]
            shown = raw.get("title") or raw.get("initialTitle") or ""
            log(f"restore: name place class={cls} score={score:.2f} {cur or '?'} -> {target} "
                f"name={clip_title(shown)!r}")
            if self._move_to_workspace(raw, w, cls):
                moved += 1
                self.placed_at[addr] = w
                self.claimed.add(addr)
            else:
                self.failed.append(cls)
        return moved

    def run(self, sess):
        self.sess = sess
        self.monitors_now = hypr_json("monitors")
        self._name_tried = set()
        self._install_name_rules(sess)
        try:
            return self._run_body(sess)
        finally:
            self._clear_name_rules()

    def _run_body(self, sess):
        try:
            apply_workspace_layouts(sess)
        except Exception as e:
            log(f"restore: workspace layouts: {e!r}")
        items = ordered_items(sess)
        for it in items:
            k, cls, wins = it["kind"], it["class"], it["windows"]
            try:
                if k == "browser":
                    prof = it.get("profile") or ""
                    existing = self.unclaimed(cls, include_known=True)
                    annotated = [self._match_client(c) for c in existing]
                    _pairs, notes = match_saved_windows(wins, annotated, prof)
                    covered = not notes
                    snapshot = False
                    if existing and covered:
                        log(f"restore: {cls} profile={prof or '-'} already has these windows; placing by title")
                        self.known -= {c["address"] for c in existing}
                    else:
                        # Always launch per profile. Chromium's singleton opens the
                        # profile in the existing process (or starts the browser).
                        # Launching without --profile-directory shows the profile picker
                        # when more than one profile was last active.
                        if existing:
                            self.known -= {c["address"] for c in existing}
                        argv = list(it["argv"])
                        ud = chromium_user_data(base(argv[0]) if argv else "", "", argv)
                        if ud and prof:
                            running = chromium_profile_is_running(ud, prof) or any(
                                c.get("profile") == prof for c in annotated)
                            snapshot, why = install_chromium_session(
                                ud, prof, running=running,
                                enabled=self.cfg.get("restore_chromium_session", True))
                            log(f"restore: chrome profile {prof} session snapshot: {why}")
                        argv = with_restore_last_session(argv)
                        if not self.launch(argv, primary_ws(it)):
                            self.failed.append(cls)
                            if not existing:
                                continue
                            snapshot = False
                            log(f"restore: {cls} profile={prof or '-'} did not launch; "
                                "placing windows that are already open")
                    wait = max(1, int(self.cfg.get("browser_wait_seconds", 150)))
                    settle = max(1, int(self.cfg.get("browser_settle_seconds", 12)))
                    now = time.time()
                    # A restored snapshot should open every window on its own.
                    # Give that a head start before replaying recently-closed
                    # windows, so a slow cold start is not duplicated.
                    reopen_after = now + (max(settle * 3, min(45, wait // 2)) if snapshot else settle)
                    self.pending.append({
                        "class": cls, "kind": "browser", "profile": prof,
                        "windows": list(wins), "remaining": list(wins), "snapshot": snapshot,
                        "deadline": now + wait, "deadline_cap": now + wait + wait // 2,
                        "reopen_after": reopen_after, "reopen_attempts": 0,
                        "reopen_budget": len(wins), "reopen_stop": False,
                    })
                    continue
                if k in ("app", "webapp"):
                    existing = self.unclaimed(cls, include_known=True)
                    if existing:
                        self.place(existing[0], wins[0])
                        if len(wins) > 1:
                            self.known -= {c["address"] for c in existing}
                            self.pending.append({"class": cls, "remaining": wins[1:], "deadline": time.time() + 10})
                        continue
                ws = ws_selector(wins[0])
                if k == "terminal":
                    self.run_terminal(it, ws)
                    continue
                argv = it["argv"]
                if not self.launch(argv, ws):
                    self.failed.append(cls)
                    continue
                timeout = self.cfg["terminal_wait_seconds"] if k == "terminal" else self.cfg["app_wait_seconds"]
                c = self.wait_new(cls, timeout)
                if not c:
                    log(f"restore: no window appeared for {cls} within {timeout}s")
                    self.failed.append(cls)
                    continue
                self.place(c, wins[0])
                if len(wins) > 1:
                    self.pending.append({"class": cls, "remaining": wins[1:],
                                         "deadline": time.time() + self.cfg["app_wait_seconds"]})
            except Exception as e:  # never let one entry stop the rest
                log(f"restore: {cls}: {e!r}")
                self.failed.append(cls)
        self.wait_pending()
        self.place_named_windows()
        self.reorder_tiled(sess)
        if self.refocus and self.prev_focus:
            dispatch(f"hl.dsp.focus({{ window = {lua_long('address:' + self.prev_focus)} }})")
        return self.placed, self.failed

    # ---- terminals: cwd, Atuin session, resumed program, tabs
    @staticmethod
    def fix_cwd(argv, cwd):
        if os.path.isdir(cwd):
            return list(argv), cwd
        log(f"restore: {cwd} no longer exists; using {HOME}")
        return [HOME if a == cwd else (a[:-len(cwd)] + HOME if a.endswith("=" + cwd) else a) for a in argv], HOME

    def run_terminal(self, it, ws):
        cls, w0 = it["class"], it["windows"][0]
        tabs = [dict(t) for t in (it.get("tabs") or
                [{"cwd": it.get("cwd") or HOME, "resume": it.get("resume"), "atuin": "", "argv": it["argv"]}])]
        for t in tabs:
            t["argv"], t["cwd"] = self.fix_cwd(t["argv"], t["cwd"])
        use_hook = self.hooked and bool(it.get("plain_argv"))
        as_tabs = use_hook and it.get("term") == "ghostty" and len(tabs) > 1
        groups = [tabs] if as_tabs else [[t] for t in tabs]
        for gi, group in enumerate(groups):
            q = None
            spec = TERMINALS.get(it.get("term") or "")
            if use_hook:
                q = make_queue(group)
                orig, g0 = it.get("cwd") or HOME, group[0]["cwd"]
                plain = [g0 if a == orig else (a[:-len(orig)] + g0 if a.endswith("=" + orig) else a)
                         for a in it["plain_argv"]]
                plain = ensure_terminal_class(plain, cls, spec)
                argv = ["env", f"OMARCHY_SR_QUEUE={q}", f"OMARCHY_SR_BIN={SELF}"] + plain
            else:
                argv = ensure_terminal_class(group[0]["argv"], cls, spec)
            try:
                if not self.launch(argv, ws):
                    self.failed.append(cls)
                    continue
                c = self.wait_new(cls, self.cfg["terminal_wait_seconds"])
                if not c:
                    log(f"restore: no window appeared for {cls} within {self.cfg['terminal_wait_seconds']}s")
                    self.failed.append(cls)
                    continue
                self.place(c, w0 if gi == 0 else dict(w0, fullscreen=0))
                if q:
                    if not wait_claims(q, 1, self.cfg["terminal_wait_seconds"]):
                        log(f"restore: {cls}: the shell did not pick up its saved state (hook not loaded?)")
                    elif len(group) > 1:
                        self.ghostty_tabs(c, q, len(group))
            finally:
                if q:
                    try:
                        os.unlink(q)
                    except OSError:
                        pass

    def ghostty_tabs(self, c, q, n):
        """Open n-1 more tabs in a freshly launched (standalone) Ghostty window.
        Ghostty has no CLI for tabs, but each window exports GTK actions on
        D-Bus (win.new-tab); they only act on the focused window, so the window
        is focused briefly and focus is handed back at the end of the restore."""
        name = dbus_name_for_pid(c["pid"])
        path = ghostty_window_path(name) if name else None
        addr = lua_long("address:" + c["address"])
        dispatch(f"hl.dsp.focus({{ window = {addr} }})")
        self.refocus = True
        time.sleep(0.3)
        for i in range(1, n):
            ok = False
            if name and path:
                rc, _ = run(["gdbus", "call", "--session", "--dest", name, "--object-path", path,
                             "--method", "org.gtk.Actions.Activate", "new-tab", "[]", "{}"])
                ok = rc == 0
            if not ok:   # fall back to Ghostty's default new_tab keybind
                dispatch(f"hl.dsp.send_shortcut({{ mods = 'CTRL SHIFT', key = 'T', window = {addr} }})")
            if not wait_claims(q, i + 1, 8):
                log(f"restore: ghostty tab {i + 1}/{n} did not start; remaining tabs skipped")
                self.failed.append(f"{c.get('class')} tab {i + 1}")
                break


def restore(args):
    cfg = load_config()
    ensure_dirs()
    with open_lock(RESTORE_LOCK) as lk:
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log("restore: another restore is running", echo=True)
            return 1
        try:
            path, sess, reason, consume = pick_session(cfg, args)
        except (ValueError, OSError) as e:
            log(f"restore: cannot load session: {e}", echo=True)
            return 1
        if sess is None:
            log(f"restore: {reason}", echo=True)
            return 0
        if getattr(args, "workspace", None):
            sess = filter_session(sess, args.workspace)
            if not args.file and not args.dry_run:
                log("restore: --workspace without --file would consume the whole saved session; "
                    "copy it and use --file", echo=True)
                return 1
        if args.dry_run:
            describe(sess, path)
            if reason and not args.force:
                print(f"Automatic restore would be SKIPPED: {reason}.")
                print("Plan it would otherwise run (dry run, nothing launched):")
            else:
                print("Restore plan (dry run, nothing launched):")
            print_plan(sess)
            return 0
        if reason and not args.force:
            log(f"restore: skipped — {reason}", echo=True)
            if reason.startswith("session is stale") and consume and path and os.path.exists(path):
                try:
                    age_seconds = time.time() - os.stat(path).st_mtime
                except OSError:
                    age_seconds = None
                if age_seconds is not None:
                    notify_restore(cfg, "stale", age_seconds=age_seconds,
                                   max_age_hours=cfg["max_age_hours"])
                try:
                    os.replace(path, os.path.join(RESTORED_DIR, "stale-" + time.strftime("%Y%m%d-%H%M%S") + ".json"))
                except OSError:
                    pass
            return 0
        sha = sha_of(path)
        # Consume SESSION/PREV before launching so a crash cannot restore twice.
        # Per-display layouts/ copies are never consumed — they are the dock memory.
        if not args.file and consume:
            stamp = time.strftime("%Y%m%d-%H%M%S")
            if os.path.exists(path):
                os.replace(path, os.path.join(RESTORED_DIR, f"session-{stamp}.json"))
            if path == SESSION and os.path.exists(PREV):
                os.replace(PREV, os.path.join(RESTORED_DIR, f"session-{stamp}.prev.json"))
        elif not args.file and not consume:
            # Still clear the top-level SESSION pointer so login restore won't re-run
            # the same apps from the legacy path after a layout-based restore.
            stamp = time.strftime("%Y%m%d-%H%M%S")
            if os.path.exists(SESSION):
                try:
                    os.replace(SESSION, os.path.join(RESTORED_DIR, f"session-{stamp}.json"))
                except OSError:
                    pass
            if os.path.exists(PREV):
                try:
                    os.replace(PREV, os.path.join(RESTORED_DIR, f"session-{stamp}.prev.json"))
                except OSError:
                    pass
        if not args.file:
            atomic_write(LAST_RESTORE, json.dumps({
                "sha": sha, "instance": instance_sig(), "at": time.time(),
                "source": path, "saved_at": sess.get("saved_at"),
                "display": (sess.get("display") or {}).get("fingerprint"),
                "display_match": sess.get("_display_match"),
            }) + "\n")
        for f in sorted(glob.glob(os.path.join(RESTORED_DIR, "*.json")))[:-20]:
            os.unlink(f)
        log(f"restore: starting ({windows_count(sess)} windows from {path}"
            f", display_match={sess.get('_display_match')})", echo=True)
        placed, failed = Restorer(cfg).run(sess)
        log(f"restore: done, {placed} windows placed; problems: {failed or 'none'}", echo=True)
        # `failed` may name app classes for the log. It is not notification text:
        # unmatched titles used to be joined into this body and passed as
        # notify-send arguments, which other local accounts can read.
        notify_restore(cfg, "incomplete" if failed else "complete",
                       placed=placed, total=windows_count(sess))
        return 0


# ----------------------------------------------------------------- daemon --
def set_pdeathsig():
    try:
        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        libc.prctl(1, signal.SIGTERM, 0, 0, 0)  # PR_SET_PDEATHSIG
    except OSError:
        pass


def socket2_path():
    rt = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    return os.path.join(rt, "hypr", instance_sig(), ".socket2.sock")


def daemon(args):
    set_pdeathsig()
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
    ensure_dirs()
    lk = open_lock(DAEMON_LOCK)
    for _ in range(30):  # a reloading plugin's old daemon may still be exiting
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            time.sleep(0.5)
    else:
        log("daemon: another daemon holds the lock; exiting")
        return 75
    lk.seek(0)
    lk.truncate()
    lk.write(str(os.getpid()))
    lk.flush()
    log(f"daemon: started (pid {os.getpid()}, v{VERSION})")
    cfg = load_config()
    if cfg["enabled"]:
        try:
            restore(argparse.Namespace(dry_run=False, force=False, file=None, prev=False, workspace=None))
        except Exception as e:
            log(f"daemon: restore failed: {e!r}")
    grace_until = time.time() + 30   # let restored windows settle before saving
    sock, buf = None, b""
    next_periodic = time.time() + 5
    pending_at = None
    first_event = None
    retry_sock = 0
    monitor_pending_at = None
    try:
        current_fp = display_fingerprint()["fingerprint"]
        remember_current_display(display_fingerprint())
    except Exception:
        current_fp = read_current_display().get("fingerprint") or ""
    while True:
        cfg = load_config()
        if not cfg["enabled"]:
            if sock:
                sock.close()
                sock = None
            time.sleep(30)
            continue
        now = time.time()
        if sock is None and now >= retry_sock:
            try:
                sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                sock.connect(socket2_path())
            except OSError as e:
                log(f"daemon: cannot connect to Hyprland event socket: {e}")
                sock, retry_sock = None, now + 30
        candidates = [next_periodic]
        if pending_at:
            candidates.append(pending_at)
        if monitor_pending_at:
            candidates.append(monitor_pending_at)
        deadline = min(candidates)
        timeout = max(0.1, deadline - now)
        if sock:
            r, _, _ = select.select([sock], [], [], timeout)
            if r:
                data = sock.recv(65536)
                if not data:
                    sock.close()
                    sock, retry_sock = None, time.time() + 5
                    continue
                buf += data
                *lines, buf = buf.split(b"\n")
                for ln in lines:
                    ev = ln.split(b">>", 1)[0].decode(errors="replace")
                    if ev in MONITOR_EVENTS:
                        # Save under the OLD fingerprint first (best-effort), then
                        # after settle switch to the matching layout for the new one.
                        monitor_pending_at = time.time() + max(1, int(cfg.get("monitor_settle_seconds", 3)))
                    elif ev in STRUCTURAL_EVENTS and ev not in TITLE_EVENTS:
                        t = time.time()
                        first_event = first_event or t
                        pending_at = min(t + cfg["event_debounce_seconds"], first_event + 15)
        else:
            time.sleep(timeout)
        now = time.time()
        if monitor_pending_at and now >= monitor_pending_at:
            monitor_pending_at = None
            if cfg.get("per_display", True):
                try:
                    # Snapshot current windows under the previous fingerprint if
                    # Hyprland hasn't already torn the old layout down completely.
                    if current_fp:
                        try:
                            save(reason="pre-hotplug")
                        except Exception as e:
                            log(f"daemon: pre-hotplug save: {e!r}")
                    new_disp = display_fingerprint()
                    new_fp = new_disp["fingerprint"]
                    if new_fp != current_fp:
                        log(f"daemon: display config changed -> {new_disp['label']}")
                        path, kind = pick_layout_path()
                        if path and kind in ("exact", "same-identities") and os.path.exists(path):
                            try:
                                sess = load_session(path)
                                n = relayout_existing(sess, cfg)
                                log(f"daemon: hotplug relayout ({kind}) placed {n}")
                            except Exception as e:
                                log(f"daemon: hotplug relayout failed: {e!r}")
                        else:
                            log(f"daemon: no saved layout for {new_disp['label']}; "
                                f"using Hyprland defaults until you arrange windows")
                        current_fp = new_fp
                        remember_current_display(new_disp)
                        grace_until = time.time() + 10
                except Exception as e:
                    log(f"daemon: monitor settle failed: {e!r}")
        due = (pending_at and now >= pending_at) or now >= next_periodic
        if due:
            reason = "event" if (pending_at and now >= pending_at) else "timer"
            pending_at = first_event = None
            next_periodic = now + max(15, cfg["save_interval_seconds"])
            if now < grace_until:
                continue
            try:
                save(reason=reason)
                try:
                    current_fp = display_fingerprint()["fingerprint"]
                except Exception:
                    pass
            except Exception as e:
                log(f"daemon: save failed: {e!r}")


def status(args):
    cfg = load_config()
    print(f"omarchy-session v{VERSION} — {'ENABLED' if cfg['enabled'] else 'DISABLED'} (config: {CONFIG})")
    pid = None
    try:
        with open(DAEMON_LOCK) as f:
            pid = int(f.read().strip() or 0)
    except (OSError, ValueError):
        pass
    alive = pid and os.path.exists(f"/proc/{pid}") and "omarchy-session" in " ".join(cmdline(pid))
    print(f"daemon: {'running, pid ' + str(pid) if alive else 'not running'}")
    for label, p in (("session", SESSION), ("previous", PREV)):
        if os.path.exists(p):
            st = os.stat(p)
            try:
                n = windows_count(load_session(p))
            except Exception as e:
                n = f"unreadable ({e})"
            print(f"{label}: {p} — {n} windows, confirmed {fmt_age(time.time() - st.st_mtime)} ago, mode {oct(st.st_mode & 0o777)}")
        else:
            print(f"{label}: none")
    try:
        disp = display_fingerprint()
        print(f"display: {disp['label']}")
        print(f"  fingerprint: {disp['fingerprint'][:100]}{'…' if len(disp['fingerprint'])>100 else ''}")
        index = load_layouts_index()
        layouts = index.get("by_fp") or {}
        print(f"  saved layouts: {len(layouts)}")
        for fp, meta in sorted(layouts.items(), key=lambda kv: -(kv[1].get("saved_at") or 0))[:8]:
            mark = " <<" if fp == disp["fingerprint"] else ""
            print(f"    - {meta.get('label', fp[:40])}: {meta.get('windows', '?')} windows, "
                  f"{fmt_age(time.time() - (meta.get('saved_at') or 0))} ago{mark}")
    except Exception as e:
        print(f"display: (unavailable: {e})")
    try:
        with open(LAST_RESTORE) as f:
            lr = json.load(f)
        print(f"last restore: {time.strftime('%Y-%m-%d %H:%M %Z', time.localtime(lr['at']))}")
    except (OSError, ValueError, KeyError):
        print("last restore: never")
    print(f"shell hook: {'installed' if hook_installed() else 'not installed (run: omarchy-session install-hook)'}"
          f" — {HOOK_FILE}")
    print(f"log: {LOG}")
    return 0


def main():
    global QUIET
    ap = argparse.ArgumentParser(prog="omarchy-session", description="Save and restore Hyprland windows (Omarchy plugin eric.session-restore)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("save", help="save the current windows now")
    s.add_argument("--final", action="store_true", help="also save an empty desktop and freeze autosave for 2 minutes (used before reboot/shutdown)")
    s.add_argument("--quiet", action="store_true")
    r = sub.add_parser("restore", help="restore the saved session")
    r.add_argument("--dry-run", "--print", action="store_true", dest="dry_run", help="show what would be launched; launch nothing")
    r.add_argument("--force", action="store_true", help="ignore the same-session/stale/already-restored/login-age checks")
    g = r.add_mutually_exclusive_group()
    g.add_argument("--file", help="restore from this session file (it is not consumed)")
    g.add_argument("--prev", action="store_true", help="use the previous good copy (session.prev.json)")
    r.add_argument("--workspace", "-w", action="append", metavar="N",
                   help="only restore windows saved on this workspace (repeatable; needs --file or --dry-run)")
    sub.add_parser("install-hook", help="add the per-terminal hook (Atuin session, tabs, resume) to ~/.bashrc / ~/.zshrc")
    sub.add_parser("uninstall-hook", help="remove that line again")
    ct = sub.add_parser("claim-tab", help="(used by the shell hook)")
    ct.add_argument("queue")
    sub.add_parser("status", help="show state")
    sub.add_parser("enable", help="turn saving and auto-restore on")
    sub.add_parser("disable", help="turn saving and auto-restore off (the plugin stays installed)")
    sub.add_parser("daemon", help="(run by the plugin service) restore once, then autosave")
    a = ap.parse_args()
    if a.cmd == "save":
        QUIET = a.quiet
        return save(final=a.final)
    if a.cmd == "restore":
        return restore(a)
    if a.cmd == "status":
        return status(a)
    if a.cmd == "claim-tab":
        return claim_tab(a.queue)
    if a.cmd == "install-hook":
        return install_hook(a)
    if a.cmd == "uninstall-hook":
        return uninstall_hook(a)
    if a.cmd in ("enable", "disable"):
        write_config_key("enabled", a.cmd == "enable")
        print(f"session restore {a.cmd}d")
        return 0
    if a.cmd == "daemon":
        QUIET = True
        return daemon(a)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
