# ------------------------------------------------------------------ utils --
def open_lock(path):
    return os.fdopen(os.open(path, os.O_RDWR | os.O_CREAT, 0o600), "r+")


def ensure_dirs():
    for d in (STATE_DIR, RESTORED_DIR):
        os.makedirs(d, mode=0o700, exist_ok=True)
        try:
            os.chmod(d, 0o700)
        except OSError:
            pass


def log(msg, echo=False):
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + msg
    if echo and not QUIET:
        print(msg, file=sys.stderr)
    try:
        ensure_dirs()
        if os.path.exists(LOG) and os.path.getsize(LOG) > 512 * 1024:
            os.replace(LOG, LOG + ".1")
        fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG) as f:
            user = json.load(f)
        if isinstance(user, dict):
            for k, v in user.items():
                if k in DEFAULTS and (type(v) is type(DEFAULTS[k]) or
                                      (isinstance(DEFAULTS[k], (int, float)) and
                                       isinstance(v, (int, float)) and not isinstance(v, bool))):
                    cfg[k] = v
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as e:
        log(f"config: ignoring unreadable {CONFIG}: {e}")
    return cfg


def write_config_key(key, value):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    data = {}
    try:
        with open(CONFIG) as f:
            data = json.load(f)
        if not isinstance(data, dict):
            data = {}
    except (OSError, ValueError):
        pass
    data[key] = value
    atomic_write(CONFIG, json.dumps(data, indent=2) + "\n", mode=0o644)


def atomic_write(path, text, mode=0o600, keep_prev=None):
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        if keep_prev and os.path.exists(path):
            ptmp = keep_prev + ".tmp"
            try:
                os.unlink(ptmp)
            except FileNotFoundError:
                pass
            os.link(path, ptmp)
            os.replace(ptmp, keep_prev)
        os.replace(tmp, path)
        dfd = os.open(d, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def run(argv, timeout=5):
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, str(e)


def notify(cfg, summary, body=""):
    if cfg.get("notify") and shutil.which("notify-send"):
        run(["notify-send", "-a", "Session Restore", "-i", "view-restore", summary, body])


def fmt_age(sec):
    sec = int(sec)
    if sec < 90:
        return f"{sec}s"
    if sec < 5400:
        return f"{sec // 60}m"
    if sec < 172800:
        return f"{sec / 3600:.1f}h"
    return f"{sec / 86400:.1f}d"


# --------------------------------------------------------------- hyprland --
def hypr_json(what):
    rc, out = run(["hyprctl", "-j", what])
    if rc != 0:
        raise RuntimeError(f"hyprctl {what} failed: {out.strip()[:200]}")
    return json.loads(out)


def lua_long(s):
    """Return s as a Lua long-bracket string literal that cannot be broken out of."""
    level = 0
    while ("]" + "=" * level + "]") in s or s.endswith("]" + "=" * level):
        level += 1
    eq = "=" * level
    # a leading newline would be swallowed by Lua; protect it
    lead = "\n" if s.startswith("\n") else ""
    return f"[{eq}[{lead}{s}]{eq}]"


def dispatch(lua):
    rc, out = run(["hyprctl", "dispatch", lua])
    ok = rc == 0 and "ok" in out.lower() and "error" not in out.lower()
    if not ok:
        log(f"dispatch failed ({rc}): {lua[:300]} -> {out.strip()[:300]}")
    return ok


def ws_selector(w):
    wid, name = w.get("workspace"), w.get("ws_name") or ""
    if isinstance(wid, int) and wid > 0 and (not name or name == str(wid)):
        return str(wid)
    if name:
        return "name:" + name
    return str(wid)


def exec_dispatch_string(argv, ws, use_uwsm=True):
    cmd = shlex.join((["uwsm-app", "--"] if use_uwsm else []) + list(argv))
    return f"hl.dsp.exec_cmd({lua_long(f'[workspace {ws} silent] {cmd}')})"


def instance_sig():
    return os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")


def boot_id():
    try:
        with open("/proc/sys/kernel/random/boot_id") as f:
            return f.read().strip()
    except OSError:
        return ""


# ------------------------------------------------------------------ /proc --
def cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            raw = f.read()
    except OSError:
        return []
    return [a.decode(errors="surrogateescape") for a in raw.split(b"\0") if a != b""] if raw else []


def exe_of(pid):
    try:
        return os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return ""


def cwd_of(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""


def stat_of(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            s = f.read()
        rest = s[s.rindex(")") + 2:].split()
        return {"ppid": int(rest[1]), "start": int(rest[19])}
    except (OSError, ValueError, IndexError):
        return {"ppid": 0, "start": 0}


def children(pid):
    kids = set()
    for p in glob.glob(f"/proc/{pid}/task/*/children"):
        try:
            with open(p) as f:
                kids.update(int(x) for x in f.read().split())
        except (OSError, ValueError):
            pass
    return sorted(kids, key=lambda k: stat_of(k)["start"])


def environ_var(pid, key):
    try:
        with open(f"/proc/{pid}/environ", "rb") as f:
            for kv in f.read().split(b"\0"):
                if kv.startswith(key.encode() + b"="):
                    return kv.split(b"=", 1)[1].decode(errors="replace")
    except OSError:
        pass
    return ""


def flatpak_id(pid):
    try:
        with open(f"/proc/{pid}/cgroup") as f:
            m = re.search(r"app-flatpak-([A-Za-z0-9._-]+?)-\d+\.scope", f.read())
            return m.group(1) if m else ""
    except OSError:
        return ""


def main_process(pid):
    """Chromium/Electron helpers carry --type=...; walk up to the browser process."""
    seen = 0
    while seen < 8:
        argv = cmdline(pid)
        if not any(a.startswith("--type=") for a in argv):
            return pid
        ppid = stat_of(pid)["ppid"]
        if ppid <= 1:
            return pid
        pid, seen = ppid, seen + 1
    return pid


def base(path):
    return os.path.basename(path or "")


def proc_basename(argv, exe):
    b = base(argv[0]) if argv else ""
    return b or base(exe)


# --------------------------------------------------------- desktop files --
def parse_exec(s):
    try:
        parts = shlex.split(s)
    except ValueError:
        return []
    out = []
    for p in parts:
        if p in FIELD_CODES:
            continue
        p = re.sub(r"%[fFuUdDnNickvm]", "", p).replace("%%", "%")
        if p:
            out.append(p)
    # strip `env VAR=x` prefixes are fine to keep; they are argv too
    return out


class DesktopIndex:
    def __init__(self):
        self.entries = []
        seen = set()
        dirs = [XDG_DATA] + (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
        dirs += [os.path.join(XDG_DATA, "flatpak/exports/share"), "/var/lib/flatpak/exports/share"]
        for d in dirs:
            appdir = os.path.join(d, "applications")
            if not os.path.isdir(appdir):
                continue
            for path in sorted(glob.glob(os.path.join(appdir, "**", "*.desktop"), recursive=True)):
                did = os.path.relpath(path, appdir).replace("/", "-")
                if did in seen:
                    continue
                seen.add(did)
                e = self._parse(path)
                if not e or e.get("Hidden", "").lower() == "true" or e.get("Type", "Application") != "Application":
                    continue
                e["id"] = did
                e["path"] = path
                e["argv"] = parse_exec(e.get("Exec", ""))
                e["cats"] = set(filter(None, e.get("Categories", "").split(";")))
                if e["argv"]:
                    self.entries.append(e)

    @staticmethod
    def _parse(path):
        entry, section = {}, None
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if line.startswith("["):
                        section = line
                        continue
                    if section != "[Desktop Entry]" or "=" not in line:
                        continue
                    k, v = line.split("=", 1)
                    k = k.strip()
                    if "[" in k:
                        continue
                    entry.setdefault(k, v.strip())
        except OSError:
            return None
        return entry

    def for_class(self, cls, exe_names=()):
        if not cls:
            return None
        c = cls.lower()
        stem = lambda e: e["id"][:-8].lower()
        for test in (
            lambda e: e.get("StartupWMClass", "").lower() == c,
            lambda e: stem(e) == c,
            lambda e: stem(e).split(".")[-1] == c,
        ):
            for e in self.entries:
                if test(e):
                    return e
        names = {n.lower() for n in exe_names if n}
        if names:
            for e in self.entries:
                if base(e["argv"][0]).lower() in names and not any(a.startswith("--app") or "://" in a for a in e["argv"][1:]):
                    return e
        return None

    def webapp_for_class(self, cls):
        for e in self.entries:
            if e.get("StartupWMClass", "") == cls:
                return e
        for e in self.entries:
            url = webapp_url_from_argv(e["argv"])
            if url and cls_matches_url(cls, url):
                return e
        return None

    def terminals(self):
        return [e for e in self.entries if "TerminalEmulator" in e["cats"]]


def webapp_url_from_argv(argv):
    for i, a in enumerate(argv):
        if a.startswith("--app="):
            return a[6:]
        if base(a) in ("omarchy-launch-webapp", "omarchy-webapp-handler") and i + 1 < len(argv):
            return argv[i + 1]
    return ""


def url_to_app_key(url):
    m = re.match(r"^[a-z]+://([^/?#]+)(/[^?#]*)?", url)
    if not m:
        return ""
    host, path = m.group(1), m.group(2) or "/"
    return host + "_" + path.replace("/", "_")


def cls_matches_url(cls, url):
    m = WEBAPP_CLASS.match(cls)
    if not m:
        return False
    key = url_to_app_key(url)
    return key and (m.group("app") == key or m.group("app") == key.rstrip("_") + "_")


def default_terminal_ids():
    ids = []
    for d in [XDG_CONFIG] + (os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":"):
        p = os.path.join(d, "xdg-terminals.list")
        try:
            with open(p) as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith(("#", "-")):
                        ids.append(line.split(":")[0])
        except OSError:
            pass
    return ids


# ------------------------------------------------------- classification --
def terminal_spec(cls, pbase, desk_entry):
    if pbase in TERMINALS:
        return pbase, TERMINALS[pbase]
    for k, spec in TERMINALS.items():
        if cls in spec["classes"] or cls.lower() in [c.lower() for c in spec["classes"]]:
            return k, spec
    if desk_entry and "TerminalEmulator" in desk_entry["cats"]:
        b = base(desk_entry["argv"][0])
        if b in TERMINALS:
            return b, TERMINALS[b]
        return b or pbase, None
    return None, None


def is_shell(pid):
    a = cmdline(pid)
    b = base(a[0]).lstrip("-") if a else ""
    return b in SHELLS or base(exe_of(pid)) in SHELLS


def resume_argv(cfg, shell_pid):
    """The foreground program in a shell, if it is one we know how to resume."""
    kids = [k for k in children(shell_pid)]
    if not kids:
        return None
    fg = kids[-1]
    a = cmdline(fg)
    if not a:
        return None
    name = base(a[0])
    if name not in cfg["resume_commands"]:
        return None
    # prefer the PATH name over versioned install paths (mise, nix, ...)
    if shutil.which(name):
        a = [name] + a[1:]
    if name == "tmux":
        sub = a[1:]
        if sub and sub[0] in ("a", "at", "attach", "attach-session"):
            t = sub[sub.index("-t") + 1] if "-t" in sub and sub.index("-t") + 1 < len(sub) else None
            a = ["tmux", "new-session", "-A"] + (["-s", t] if t else [])
        elif sub[:1] in (["new"], ["new-session"]) and "-s" in sub:
            i = sub.index("-s")
            if i + 1 < len(sub):
                a = ["tmux", "new-session", "-A", "-s", sub[i + 1]]
    if name == "zellij" and len(a) > 1 and a[1] in ("attach", "a") and len(a) > 2:
        a = ["zellij", "attach", "--create", a[-1]]
    return a


# ------------------------------------------------------------ agents --
# Coding-agent CLIs and how to get back into the conversation that was open.
#   bins   executable names (the first is what gets launched; the shell resolves
#          it through PATH, so mise/npm/nix shims keep working)
#   pkg    path fragments that identify the agent when it runs as
#          `node .../cli.js`, `python -m ...` or from a versioned install dir
#   ids    flags that carry a session id on the original command line
#   sub    subcommand that takes the id positionally (`codex resume <id>`)
#   resume argv tail that resumes {id}
#   cont   argv tail that resumes the most recent session in the cwd, used when
#          no id can be found (None: the agent is restarted fresh — no prompt is
#          ever sent, so this never starts a conversation)
#   carry  flags WITH a value copied from the original command (model,
#          permission mode, ...); carry_bare: bare flags copied. Nothing is ever
#          added: permission-skipping flags only come back if they were there.
#   skip   flags / subcommands meaning a one-shot, non-interactive run
#   fd     regex over the agent's open files whose group 1 is the session id
AGENTS = {
    "claude": dict(bins=["claude"], pkg=["@anthropic-ai/claude-code", "/installs/claude/"],
                   ids=["--resume", "-r"], resume=["--resume", "{id}"], cont=["--continue"],
                   carry=["--model", "--permission-mode", "--add-dir", "--agent", "--settings",
                          "--mcp-config", "--fallback-model"],
                   carry_bare=["--dangerously-skip-permissions", "--allow-dangerously-skip-permissions",
                               "--ide", "--chrome", "--verbose"],
                   skip=["-p", "--print"],
                   fd=r"/\.claude/projects/[^/]+/([0-9a-fA-F-]{36})\.jsonl$"),
    "codex": dict(bins=["codex"], pkg=["@openai/codex", "/installs/codex/"],
