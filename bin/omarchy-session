# ------------------------------------------------------------------ utils --
def open_lock(path):
    return os.fdopen(os.open(path, os.O_RDWR | os.O_CREAT, 0o600), "r+")


def ensure_dirs():
    for d in (STATE_DIR, RESTORED_DIR, LAYOUTS_DIR, os.path.join(STATE_DIR, "chrome-sessions")):
        os.makedirs(d, mode=0o700, exist_ok=True)
        try:
            os.chmod(d, 0o700)
        except OSError:
            pass


def log(msg, echo=False):
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + msg
    if echo and not QUIET:
        print(msg, file=sys.stderr)
    try:
        ensure_dirs()
        if os.path.exists(LOG) and os.path.getsize(LOG) > 512 * 1024:
            os.replace(LOG, LOG + ".1")
        fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG) as f:
            user = json.load(f)
        if isinstance(user, dict):
            for k, v in user.items():
                if k in DEFAULTS and (type(v) is type(DEFAULTS[k]) or
                                      (isinstance(DEFAULTS[k], (int, float)) and
                                       isinstance(v, (int, float)) and not isinstance(v, bool))):
                    cfg[k] = v
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as e:
        log(f"config: ignoring unreadable {CONFIG}: {e}")
    return cfg


def write_config_key(key, value):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    data = {}
    try:
        with open(CONFIG) as f:
            data = json.load(f)
        if not isinstance(data, dict):
            data = {}
    except (OSError, ValueError):
        pass
    data[key] = value
    atomic_write(CONFIG, json.dumps(data, indent=2) + "\n", mode=0o644)


def atomic_write(path, text, mode=0o600, keep_prev=None):
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        if keep_prev and os.path.exists(path):
            ptmp = keep_prev + ".tmp"
            try:
                os.unlink(ptmp)
            except FileNotFoundError:
                pass
            os.link(path, ptmp)
            os.replace(ptmp, keep_prev)
        os.replace(tmp, path)
        dfd = os.open(d, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def run(argv, timeout=5):
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, str(e)


def _notify_number(value):
    """Counts and ages only. Strings are rejected so session text cannot be interpolated."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise TypeError("notify-send copy accepts numbers only")
    return value


def restore_notify_message(outcome, placed=0, total=0, age_seconds=0, max_age_hours=0):
    """Return (summary, body) for a restore notification, or None to stay quiet.

    The only non-literal values are numbers. There is no parameter for a
    window title, path, or other saved-session text, so none can reach
    notify-send.
    """
    if outcome == "stale":
        age = _notify_number(age_seconds)
        hours = _notify_number(max_age_hours)
        return "Session not restored", f"session is stale ({fmt_age(age)} old > {hours}h)"
    if outcome not in ("complete", "incomplete"):
        return None
    summary = f"Restored {int(_notify_number(placed))} of {int(_notify_number(total))} windows"
    if outcome == "incomplete":
        return summary, "Some windows could not be restored"
    return summary, ""


def notify_restore(cfg, outcome, placed=0, total=0, age_seconds=0, max_age_hours=0):
    """Show the restore notification for `outcome`.

    Copy is built by restore_notify_message(). Callers cannot pass a body.
    """
    if not cfg.get("notify") or not shutil.which("notify-send"):
        return
    try:
        message = restore_notify_message(outcome, placed=placed, total=total,
                                         age_seconds=age_seconds, max_age_hours=max_age_hours)
    except TypeError as e:
        # Do not log the rejected value: it might be session text.
        log(f"notify: refused notification ({e})")
        return
    if message is None:
        log("notify: ignoring unknown outcome")
        return
    summary, body = message
    run(["notify-send", "-a", "Session Restore", "-i", "view-restore", summary, body])


def note_unmatched_windows(failed, cls, windows, notes=None, profile=""):
    """Log why saved windows never matched.

    Appends one class-name tally per window onto `failed`. Titles stay in the
    mode-600 log: `failed` is summarized later and must not carry them into
    a notification. Returns a title-free summary suitable for stderr.
    """
    by_title = {}
    for note in notes or []:
        by_title[note.get("title") or ""] = note
    for w in windows:
        raw = w.get("title") or ""
        failed.append(cls)
        note = by_title.get(raw) or {}
        best = note.get("best")
        best_s = f"{best:.2f}" if isinstance(best, float) else "-"
        log("restore: unmatched "
            f"class={cls} profile={profile or '-'} workspace={w.get('workspace')} "
            f"score={best_s} candidates={note.get('candidates', 0)} "
            f"profile_candidates={note.get('profile_candidates', 0)} "
            f"title={clip_title(raw)!r} best_title={clip_title(note.get('best_title') or '')!r} "
            f"best_profile={note.get('best_profile') or '-'}")
    return f"restore: {len(windows)} {cls} window(s) unmatched (details in session log)"


def fmt_age(sec):
    sec = int(sec)
    if sec < 90:
        return f"{sec}s"
    if sec < 5400:
        return f"{sec // 60}m"
    if sec < 172800:
        return f"{sec / 3600:.1f}h"
    return f"{sec / 86400:.1f}d"


# --------------------------------------------------------------- hyprland --
def hypr_json(what):
    rc, out = run(["hyprctl", "-j", what])
    if rc != 0:
        raise RuntimeError(f"hyprctl {what} failed: {out.strip()[:200]}")
    return json.loads(out)


def lua_long(s):
    """Return s as a Lua long-bracket string literal that cannot be broken out of."""
    level = 0
    while ("]" + "=" * level + "]") in s or s.endswith("]" + "=" * level):
        level += 1
    eq = "=" * level
    # a leading newline would be swallowed by Lua; protect it
    lead = "\n" if s.startswith("\n") else ""
    return f"[{eq}[{lead}{s}]{eq}]"


def dispatch(lua):
    rc, out = run(["hyprctl", "dispatch", lua])
    ok = rc == 0 and "ok" in out.lower() and "error" not in out.lower()
    if not ok:
        log(f"dispatch failed ({rc}): {lua[:300]} -> {out.strip()[:300]}")
    return ok


def ws_selector(w):
    wid, name = w.get("workspace"), w.get("ws_name") or ""
    # Special/scratchpad workspaces have negative ids; Hyprland wants the name
    # (special:scratchpad), not name:special:scratchpad or the negative id.
    if isinstance(wid, int) and wid < 0 and name.startswith("special"):
        return name
    if isinstance(wid, int) and wid > 0 and (not name or name == str(wid)):
        return str(wid)
    if name:
        return "name:" + name
    return str(wid)


def exec_dispatch_string(argv, ws, use_uwsm=True):
    cmd = shlex.join((["uwsm-app", "--"] if use_uwsm else []) + list(argv))
    return f"hl.dsp.exec_cmd({lua_long(f'[workspace {ws} silent] {cmd}')})"


def instance_sig():
    return os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")


def boot_id():
    try:
        with open("/proc/sys/kernel/random/boot_id") as f:
            return f.read().strip()
    except OSError:
        return ""


# ------------------------------------------------ display fingerprint --
def monitor_identity(m):
    """Stable physical-monitor id. Matches Omarchy's monitor-workspaces.lua:
    make/model/serial via description, not the connector (HDMI-A-1) which a
    dock can rename between plugs."""
    desc = (m.get("description") or "").strip()
    if desc:
        return desc
    parts = [p for p in (m.get("make"), m.get("model"), m.get("serial")) if p]
    if parts:
        return " ".join(parts)
    return m.get("name") or f"monitor-{m.get('id', '?')}"


def monitor_meta(m):
    return {
        "id": m.get("id"),
        "name": m.get("name"),
        "identity": monitor_identity(m),
        "make": m.get("make") or "",
        "model": m.get("model") or "",
        "serial": m.get("serial") or "",
        "description": m.get("description") or "",
        "width": m.get("width"),
        "height": m.get("height"),
        "x": m.get("x"),
        "y": m.get("y"),
        "scale": m.get("scale"),
        "refreshRate": m.get("refreshRate"),
    }


def display_fingerprint(monitors=None):
    """Fingerprint for the current set of connected displays.

    Sorted by relative position then identity so the same physical setup
    yields the same key regardless of Hyprland monitor id assignment.
    Geometry (resolution, scale, position) is part of the key so a docked
    ultrawide and the same panel at a different resolution stay distinct."""
    if monitors is None:
        monitors = hypr_json("monitors")
    metas = [monitor_meta(m) for m in monitors if not m.get("disabled")]
    metas.sort(key=lambda m: (m.get("x") or 0, m.get("y") or 0, m["identity"], m.get("name") or ""))
    parts = []
    for m in metas:
        sc = m.get("scale") or 1
        try:
            sc = float(sc)
        except (TypeError, ValueError):
            sc = 1.0
        parts.append(f"{m['identity']}@{m['width']}x{m['height']}+{m['x']}+{m['y']}s{sc:g}")
    fp = "|".join(parts) or "no-monitors"
    h = hashlib.sha1(fp.encode()).hexdigest()[:16]
    if len(metas) == 1:
        m0 = metas[0]
        label = f"{m0['identity']} {m0['width']}×{m0['height']}"
    else:
        label = " + ".join(f"{m['identity'].split()[-1] if m['identity'] else m['name']} {m['width']}×{m['height']}"
                           for m in metas)
    return {"fingerprint": fp, "hash": h, "label": label, "monitors": metas}


def layout_session_path(fp_hash):
    return os.path.join(LAYOUTS_DIR, fp_hash, "session.json")


def load_layouts_index():
    try:
        with open(LAYOUTS_INDEX) as f:
            data = json.load(f)
        if isinstance(data, dict):
            return data
    except (OSError, ValueError):
        pass
    return {"by_fp": {}, "current_fp": ""}


def save_layouts_index(index):
    ensure_dirs()
    atomic_write(LAYOUTS_INDEX, json.dumps(index, indent=2) + "\n", 0o600)


def remember_current_display(display):
    ensure_dirs()
    atomic_write(CURRENT_FP_FILE, json.dumps({
        "fingerprint": display["fingerprint"],
        "hash": display["hash"],
        "label": display["label"],
        "at": time.time(),
    }) + "\n", 0o600)


def read_current_display():
    try:
        with open(CURRENT_FP_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_layout_copy(sess, display):
    """Persist this session under its display fingerprint (never consumed on restore)."""
    ensure_dirs()
    d = os.path.join(LAYOUTS_DIR, display["hash"])
    os.makedirs(d, mode=0o700, exist_ok=True)
    atomic_write(layout_session_path(display["hash"]), json.dumps(sess, indent=1) + "\n", 0o600)
    index = load_layouts_index()
    index.setdefault("by_fp", {})[display["fingerprint"]] = {
        "hash": display["hash"],
        "label": display["label"],
        "saved_at": sess.get("saved_at"),
        "windows": windows_count(sess),
        "monitors": display["monitors"],
    }
    index["current_fp"] = display["fingerprint"]
    save_layouts_index(index)
    remember_current_display(display)


def identities_of(display_or_monitors):
    if isinstance(display_or_monitors, dict) and "monitors" in display_or_monitors:
        mons = display_or_monitors["monitors"]
    else:
        mons = display_or_monitors
    return tuple(sorted((m.get("identity") or monitor_identity(m)) for m in mons))


def pick_layout_path(monitors=None, prefer_exact=True):
    """Best saved layout path for the current (or given) display configuration.

    Exact fingerprint match → same monitor identities (any geometry) → most
    recently saved layout. Returns (path, match_kind) or (None, reason)."""
    display = display_fingerprint(monitors)
    exact = layout_session_path(display["hash"])
    if prefer_exact and os.path.exists(exact):
        return exact, "exact"
    index = load_layouts_index()
    by_fp = index.get("by_fp") or {}
    want = set(identities_of(display))
    candidates = []
    for fp, meta in by_fp.items():
        path = layout_session_path(meta.get("hash") or "")
        if not path or not os.path.exists(path):
            continue
        ids = set(identities_of(meta.get("monitors") or []))
        if ids == want and ids:
            kind, score = "same-identities", 3
        elif want and ids and (want & ids):
            kind, score = "overlap", 2
        else:
            kind, score = "other", 1
        candidates.append((score, meta.get("saved_at") or 0, kind, path, fp))
    if not candidates:
        if os.path.exists(SESSION):
            return SESSION, "legacy-session"
        return None, "no-layouts"
    candidates.sort(key=lambda t: (t[0], t[1]), reverse=True)
    score, _, kind, path, _ = candidates[0]
    if score >= 2:
        return path, kind
    return path, "fallback"


def clamp_floating(w, monitors_now, monitors_saved):
    """If a floating window's saved position is off-screen now, move it onto the
    primary (or matching-identity) monitor instead of forcing a bad coordinate."""
    if not w.get("floating") or not w.get("at") or not w.get("size"):
        return w
    at, size = list(w["at"]), list(w["size"])
    if not monitors_now:
        return w
    # Prefer a live monitor with the same identity as when saved
    target = None
    mid = w.get("monitor_identity")
    if mid:
        for m in monitors_now:
            if monitor_identity(m) == mid or m.get("identity") == mid:
                target = m
                break
    if target is None:
        # primary = focused, else origin-most
        target = next((m for m in monitors_now if m.get("focused")), None) or sorted(
            monitors_now, key=lambda m: (m.get("x") or 0, m.get("y") or 0))[0]
    mx, my = target.get("x") or 0, target.get("y") or 0
    mw, mh = int(target.get("width") or 1920), int(target.get("height") or 1080)
    x, y = int(at[0]), int(at[1])
    sw, sh = max(50, int(size[0])), max(50, int(size[1]))
    # Off this monitor (with a small margin)? Snap into it.
    if x + sw < mx + 8 or y + sh < my + 8 or x > mx + mw - 8 or y > my + mh - 8:
        x = mx + max(0, (mw - sw) // 4)
        y = my + max(0, (mh - sh) // 4)
    sw = min(sw, mw - 16)
    sh = min(sh, mh - 16)
    out = dict(w)
    out["at"] = [x, y]
    out["size"] = [sw, sh]
    return out


def apply_workspace_layouts(sess):
    """Apply per-workspace dwindle/scrolling/floating if Omarchy's o.workspace_mode exists.

    Exact dwindle split trees and hyprscrolling column widths are not exposed
    by Hyprland IPC, so this only restores the layout *mode*."""
    for ws in sess.get("workspaces") or []:
        mode = ws.get("tiledLayout") or ws.get("layout")
        wid = ws.get("id")
        if not mode or not isinstance(wid, int) or wid <= 0:
            continue
        if mode not in ("dwindle", "scrolling", "master", "floating"):
            continue
        # Prefer Omarchy helper; fall back to a workspace_rule for tiled modes.
        rc, out = run(["hyprctl", "eval",
                       f'o.workspace_mode({{ workspace = "{wid}", mode = "{mode}" }})'])
        if rc != 0 or "error" in (out or "").lower():
            if mode != "floating":
                run(["hyprctl", "eval",
                     f'hl.workspace_rule({{ workspace = "{wid}", layout = "{mode}" }})'])


def move_workspace_to_monitor(ws_id, monitor_name):
    if not isinstance(ws_id, int) or ws_id <= 0 or not monitor_name:
        return
    L = lua_long
    dispatch(f"hl.dsp.workspace.move({{ workspace = {L(str(ws_id))}, monitor = {L(monitor_name)} }})")


def resolve_monitor_name(identity_or_name, monitors_now):
    if not identity_or_name:
        return None
    for m in monitors_now:
        if m.get("name") == identity_or_name:
            return m["name"]
        if monitor_identity(m) == identity_or_name:
            return m["name"]
    return None


# ------------------------------------------------------------------ /proc --
def cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            raw = f.read()
    except OSError:
        return []
    if not raw:
        return []
    parts = [a.decode(errors="surrogateescape") for a in raw.split(b"\0") if a != b""]
    # Chrome sometimes rewrites argv into one space-joined string with no NULs.
    if len(parts) == 1 and (" --" in parts[0] or parts[0].count(" ") >= 2):
        return split_joined_argv(parts[0])
    return parts


def split_joined_argv(blob):
    """Split a NUL-less cmdline without breaking flag values that contain spaces.

    shlex.split("--profile-directory=Profile 1 --restore-last-session") yields
    "--profile-directory=Profile" and "1", because the value was never quoted.
    A new flag is whitespace followed by "--"; the value may contain spaces
    until that point.
    """
    blob = (blob or "").strip()
    if not blob:
        return []
    if " --" in blob or blob.startswith("--"):
        return [p for p in re.split(r"\s+(?=--)", blob) if p]
    try:
        return shlex.split(blob)
    except ValueError:
        return blob.split()


def profile_from_argv(argv):
    for a in argv or []:
        if isinstance(a, str) and a.startswith("--profile-directory="):
            return a.split("=", 1)[1]
    return ""


def profile_from_window_class(cls):
    """Profile embedded in a PWA class, e.g. chrome-<app>-Profile_1."""
    m = WEBAPP_CLASS.match(cls or "")
    if not m:
        return ""
    return m.group("profile").replace("_", " ")


def saved_browser_profiles(sess, cls):
    out = []
    for it in (sess or {}).get("items") or []:
        if it.get("kind") != "browser":
            continue
        if (it.get("class") or "").lower() != (cls or "").lower():
            continue
        prof = it.get("profile") or ""
        if prof:
            out.append(prof)
    return out


def client_profile(process_profile, cls, saved_profiles):
    """Profile to use when matching a live window.

    A PWA class names its profile. Ordinary Chrome windows do not: every
    profile's windows share one browser process, and --profile-directory on
    that process only names whichever profile was launched first. With more
    than one saved profile, ignore the process and match by title.
    """
    embedded = profile_from_window_class(cls)
    if embedded:
        return embedded
    if len(set(saved_profiles or [])) > 1:
        return ""
    return process_profile or ""


def exe_of(pid):
    try:
        return os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return ""


def cwd_of(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""


def stat_of(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            s = f.read()
        rest = s[s.rindex(")") + 2:].split()
        return {"ppid": int(rest[1]), "start": int(rest[19])}
    except (OSError, ValueError, IndexError):
        return {"ppid": 0, "start": 0}


def children(pid):
    kids = set()
    for p in glob.glob(f"/proc/{pid}/task/*/children"):
        try:
            with open(p) as f:
                kids.update(int(x) for x in f.read().split())
        except (OSError, ValueError):
            pass
    return sorted(kids, key=lambda k: stat_of(k)["start"])


def environ_var(pid, key):
    try:
        with open(f"/proc/{pid}/environ", "rb") as f:
            for kv in f.read().split(b"\0"):
                if kv.startswith(key.encode() + b"="):
                    return kv.split(b"=", 1)[1].decode(errors="replace")
    except OSError:
        pass
    return ""


def flatpak_id(pid):
    try:
        with open(f"/proc/{pid}/cgroup") as f:
            m = re.search(r"app-flatpak-([A-Za-z0-9._-]+?)-\d+\.scope", f.read())
            return m.group(1) if m else ""
    except OSError:
        return ""


def main_process(pid):
    """Chromium/Electron helpers carry --type=...; walk up to the browser process."""
    seen = 0
    while seen < 8:
        argv = cmdline(pid)
        if not any(a.startswith("--type=") for a in argv):
            return pid
        ppid = stat_of(pid)["ppid"]
        if ppid <= 1:
            return pid
        pid, seen = ppid, seen + 1
    return pid


def base(path):
    return os.path.basename(path or "")


def strip_deleted(path):
    """Kernel appends ' (deleted)' when the binary was replaced under a running process."""
    if path and path.endswith(" (deleted)"):
        return path[:-10]
    return path or ""


def proc_basename(argv, exe):
    b = ""
    if argv:
        first = argv[0]
        # Concatenated cmdline blob: "/opt/google/chrome/chrome --type=..."
        if " --" in first or (first.startswith("/") and " " in first):
            first = first.split()[0]
        b = base(first)
    e = base(strip_deleted(exe))
    return b or e


# --------------------------------------------------------- desktop files --
def parse_exec(s):
    try:
        parts = shlex.split(s)
    except ValueError:
        return []
    out = []
    for p in parts:
        if p in FIELD_CODES:
            continue
        p = re.sub(r"%[fFuUdDnNickvm]", "", p).replace("%%", "%")
        if p:
            out.append(p)
    # strip `env VAR=x` prefixes are fine to keep; they are argv too
    return out


class DesktopIndex:
    def __init__(self):
        self.entries = []
        seen = set()
        dirs = [XDG_DATA] + (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
        dirs += [os.path.join(XDG_DATA, "flatpak/exports/share"), "/var/lib/flatpak/exports/share"]
        for d in dirs:
            appdir = os.path.join(d, "applications")
            if not os.path.isdir(appdir):
                continue
            for path in sorted(glob.glob(os.path.join(appdir, "**", "*.desktop"), recursive=True)):
                did = os.path.relpath(path, appdir).replace("/", "-")
                if did in seen:
                    continue
                seen.add(did)
                e = self._parse(path)
                if not e or e.get("Hidden", "").lower() == "true" or e.get("Type", "Application") != "Application":
                    continue
                e["id"] = did
                e["path"] = path
                e["argv"] = parse_exec(e.get("Exec", ""))
                e["cats"] = set(filter(None, e.get("Categories", "").split(";")))
                if e["argv"]:
                    self.entries.append(e)

    @staticmethod
    def _parse(path):
        entry, section = {}, None
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if line.startswith("["):
                        section = line
                        continue
                    if section != "[Desktop Entry]" or "=" not in line:
                        continue
                    k, v = line.split("=", 1)
                    k = k.strip()
                    if "[" in k:
                        continue
                    entry.setdefault(k, v.strip())
        except OSError:
            return None
        return entry

    def for_class(self, cls, exe_names=()):
        if not cls:
            return None
        c = cls.lower()
        stem = lambda e: e["id"][:-8].lower()
        for test in (
            lambda e: e.get("StartupWMClass", "").lower() == c,
            lambda e: stem(e) == c,
            lambda e: stem(e).split(".")[-1] == c,
        ):
            for e in self.entries:
                if test(e):
                    return e
        names = {n.lower() for n in exe_names if n}
        if names:
            for e in self.entries:
                if base(e["argv"][0]).lower() in names and not any(a.startswith("--app") or "://" in a for a in e["argv"][1:]):
                    return e
        return None

    def webapp_for_class(self, cls):
        for e in self.entries:
            if e.get("StartupWMClass", "") == cls:
                return e
        for e in self.entries:
            url = webapp_url_from_argv(e["argv"])
            if url and cls_matches_url(cls, url):
                return e
        return None

    def terminals(self):
        return [e for e in self.entries if "TerminalEmulator" in e["cats"]]


def webapp_url_from_argv(argv):
    for i, a in enumerate(argv):
        if a.startswith("--app="):
            return a[6:]
        if base(a) in ("omarchy-launch-webapp", "omarchy-webapp-handler") and i + 1 < len(argv):
            return argv[i + 1]
    return ""


def url_to_app_key(url):
    m = re.match(r"^[a-z]+://([^/?#]+)(/[^?#]*)?", url)
    if not m:
        return ""
    host, path = m.group(1), m.group(2) or "/"
    return host + "_" + path.replace("/", "_")


def cls_matches_url(cls, url):
    m = WEBAPP_CLASS.match(cls)
    if not m:
        return False
    key = url_to_app_key(url)
    return key and (m.group("app") == key or m.group("app") == key.rstrip("_") + "_")


def default_terminal_ids():
    ids = []
    for d in [XDG_CONFIG] + (os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":"):
        p = os.path.join(d, "xdg-terminals.list")
        try:
            with open(p) as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith(("#", "-")):
                        ids.append(line.split(":")[0])
        except OSError:
            pass
    return ids


# ------------------------------------------------------- classification --
def terminal_spec(cls, pbase, desk_entry):
    if pbase in TERMINALS:
        return pbase, TERMINALS[pbase]
    for k, spec in TERMINALS.items():
        if cls in spec["classes"] or cls.lower() in [c.lower() for c in spec["classes"]]:
            return k, spec
    if desk_entry and "TerminalEmulator" in desk_entry["cats"]:
        b = base(desk_entry["argv"][0])
        if b in TERMINALS:
            return b, TERMINALS[b]
        return b or pbase, None
    return None, None


def is_shell(pid):
    a = cmdline(pid)
    b = base(a[0]).lstrip("-") if a else ""
    return b in SHELLS or base(exe_of(pid)) in SHELLS


def resume_argv(cfg, shell_pid):
    """The foreground program in a shell, if it is one we know how to resume."""
    kids = [k for k in children(shell_pid)]
    if not kids:
        return None
    fg = kids[-1]
    a = cmdline(fg)
    if not a:
        return None
    name = base(a[0])
    if name not in cfg["resume_commands"]:
        return None
    # prefer the PATH name over versioned install paths (mise, nix, ...)
    if shutil.which(name):
        a = [name] + a[1:]
    if name == "tmux":
        sub = a[1:]
        if sub and sub[0] in ("a", "at", "attach", "attach-session"):
            t = sub[sub.index("-t") + 1] if "-t" in sub and sub.index("-t") + 1 < len(sub) else None
            a = ["tmux", "new-session", "-A"] + (["-s", t] if t else [])
        elif sub[:1] in (["new"], ["new-session"]) and "-s" in sub:
            i = sub.index("-s")
            if i + 1 < len(sub):
                a = ["tmux", "new-session", "-A", "-s", sub[i + 1]]
    if name == "zellij" and len(a) > 1 and a[1] in ("attach", "a") and len(a) > 2:
        a = ["zellij", "attach", "--create", a[-1]]
    return a


# ------------------------------------------------------------ agents --
# Coding-agent CLIs and how to get back into the conversation that was open.
#   bins   executable names (the first is what gets launched; the shell resolves
#          it through PATH, so mise/npm/nix shims keep working)
#   pkg    path fragments that identify the agent when it runs as
#          `node .../cli.js`, `python -m ...` or from a versioned install dir
#   ids    flags that carry a session id on the original command line
#   sub    subcommand that takes the id positionally (`codex resume <id>`)
#   resume argv tail that resumes {id}
#   cont   argv tail that resumes the most recent session in the cwd, used when
#          no id can be found (None: the agent is restarted fresh — no prompt is
#          ever sent, so this never starts a conversation)
#   carry  flags WITH a value copied from the original command (model,
#          permission mode, ...); carry_bare: bare flags copied. Nothing is ever
#          added: permission-skipping flags only come back if they were there.
#   skip   flags / subcommands meaning a one-shot, non-interactive run
#   fd     regex over the agent's open files whose group 1 is the session id
AGENTS = {
    "claude": dict(bins=["claude"], pkg=["@anthropic-ai/claude-code", "/installs/claude/"],
                   ids=["--resume", "-r"], resume=["--resume", "{id}"], cont=["--continue"],
                   carry=["--model", "--permission-mode", "--add-dir", "--agent", "--settings",
                          "--mcp-config", "--fallback-model"],
                   carry_bare=["--dangerously-skip-permissions", "--allow-dangerously-skip-permissions",
                               "--ide", "--chrome", "--verbose"],
                   skip=["-p", "--print"],
                   fd=r"/\.claude/projects/[^/]+/([0-9a-fA-F-]{36})\.jsonl$"),
    "codex": dict(bins=["codex"], pkg=["@openai/codex", "/installs/codex/"],
                  sub="resume", resume=["resume", "{id}"], cont=["resume", "--last"],
                  carry=["--model", "-m", "--sandbox", "-s", "--ask-for-approval", "-a", "--profile", "-p"],
                  carry_bare=["--dangerously-bypass-approvals-and-sandbox", "--yolo", "--full-auto", "--search"],
                  skip=["exec", "e", "apply", "login", "logout", "mcp", "completion", "app-server", "cloud"],
                  fd=r"rollout-[^/]*-([0-9a-fA-F]{8}-[0-9a-fA-F-]{27})\.jsonl$"),
    "grok": dict(bins=["grok"], pkg=["/installs/grok/", "/.grok/bin/"],
                 ids=["--resume", "-r", "--session-id", "-s"], resume=["--resume", "{id}"], cont=["--continue"],
                 carry=["--model", "-m", "--permission-mode", "--sandbox"], carry_bare=["--always-approve"],
                 skip=["-p", "--print", "--prompt"],
                 fd=r"/\.grok/sessions/[^/]+/([0-9a-fA-F-]{32,36})/"),
    "cursor-agent": dict(bins=["cursor-agent"], pkg=["cursor-agent"],
                         ids=["--resume"], resume=["--resume", "{id}"], cont=["--continue"],
                         carry=["--model", "-m", "--sandbox"],
                         carry_bare=["-f", "--force", "--yolo", "--approve-mcps", "--trust", "--browser"],
                         skip=["-p", "--print", "login", "logout", "status", "mcp", "update", "ls"],
                         fd=r"/\.cursor/chats/[^/]+/([0-9a-fA-F-]{36})/"),
    "gemini": dict(bins=["gemini"], pkg=["@google/gemini-cli"],
                   ids=["--resume", "-r"], resume=["--resume", "{id}"], cont=["--resume", "latest"],
                   carry=["--model", "-m", "--approval-mode"], carry_bare=["--yolo", "-y", "--sandbox", "-s"],
                   skip=["-p", "--prompt"]),
    "opencode": dict(bins=["opencode"], pkg=["opencode-ai", "/installs/opencode/"],
                     ids=["--session", "-s"], resume=["--session", "{id}"], cont=["--continue"],
                     carry=["--model", "-m", "--agent"], skip=["run", "serve", "auth", "mcp"]),
    "kilo": dict(bins=["kilo", "kilocode"], pkg=["@kilocode/cli"],
                 ids=["--session", "-s"], resume=["--session", "{id}"], cont=["--continue"],
                 carry=["--model", "-m"]),
    "kimi": dict(bins=["kimi"], pkg=["@moonshot-ai/kimi-code", "kimi_cli", "kimi-cli"],
                 ids=["--session", "-S"], resume=["--session", "{id}"], cont=["--continue"],
                 carry=["--model", "-m"], carry_bare=["--yolo", "-y", "--auto"],
                 skip=["-p", "--print", "--prompt"],
                 fd=r"/\.kimi/sessions/[^/]+/([0-9a-fA-F-]{32,36})"),
    "qwen": dict(bins=["qwen"], pkg=["@qwen-code/qwen-code"],
                 ids=["--resume", "-r"], resume=["--resume", "{id}"], cont=["--continue"],
                 carry=["--model", "-m", "--approval-mode"], carry_bare=["--yolo", "-y"], skip=["-p", "--prompt"]),
    "copilot": dict(bins=["copilot"], pkg=["@github/copilot"],
                    ids=["--resume"], resume=["--resume={id}"], cont=["--continue"],
                    carry=["--model", "--agent"],
                    carry_bare=["--allow-all-tools", "--allow-all-paths", "--allow-all", "--yolo"],
